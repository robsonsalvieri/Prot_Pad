#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include "totvs.ch"

#DEFINE CodeRespCreated 201
#DEFINE CodeRespBadRequest 400
 
Static aSM0

/*-------------------------------------------------------------------
{Protheus.doc} GPEResiduoCreditoTrabalhador
Classe responsável pela comunicação com a rotina de Residuos do Credito do Trabalhador (GPEM947)

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
class GPEResiduoCreditoTrabalhador

	public method new() as object

    @Post(endpoint='/api/rh/v1/residuos/status', description='API de atualiza o status do e-mail') 
	public method setStatusResiduo() as object

	@POST(endpoint='/api/rh/v1/residuos/enviaremail', description='API para enviar email e atualizar status do envio') 
	public method postEmailResiduos() as object

    @Get(endpoint='/api/rh/v1/residuos/branches', description='API de busca das filiais da SM0') 
	public method getFiliais() as object

    @Get(endpoint='/api/rh/v1/residuos/branches/:filial', description='API de busca de uma filial da SM0') 
	public method getFilial() as object
    
	@Get(endpoint='/api/rh/v1/residuos/lista', description='API de busca da lista de funcionarios com residuo de credito do trabalhador') 
	public method getListaResiduos() as object 
    
    private method getUltPerFec() as character
    private method atualizarStatus() as logical
    private method montaHtmlEmail() as character
    private method formataMoeda() as character
    private method getTotalResiduos() as numeric

endclass

/*-------------------------------------------------------------------
{Protheus.doc} GPEResiduoCreditoTrabalhador::new
Construtor da classe GPEResiduoCreditoTrabalhador

@return Self, objeto do tipo GPEResiduoCreditoTrabalhador
@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method new() as object class GPEResiduoCreditoTrabalhador
return self

/*-------------------------------------------------------------------
{Protheus.doc} Post postEmailResiduos
API de envio de e-mail e atualização do status do envio

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method postEmailResiduos() class GPEResiduoCreditoTrabalhador

    Local cChave as Character
    Local cStatusResiduo as Character
    Local cEmail as Character
    Local cMailAssunto as Character
    Local cMailHtml as Character
    Local cNome as Character
    Local cMat as Character
    Local lRet as Logical
    Local nFunc as Numeric
    Local nResiduo as Numeric
    Local oItem	as Object
    Local oResponse := JsonObject():New() as Json
    Local oJsBody := JsonObject():new() as Json
    local oJsBadResp as object

    oJsBody:fromJson( oRest:GetBodyRequest() )
	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oResponse["items"] := {}

    If Valtype(oJsBody["items"]) != "U" .And. Len(oJsBody["items"]) > 0

        For nFunc := 1 To Len(oJsBody["items"]) 
            cEmail := oJsBody["items"][nFunc]["email"]

            If !Empty(cEmail)
                cMailAssunto := "Comunicação de resíduo do Crédito do Trabalhador"
                cEmail       := oJsBody["items"][nFunc]["email"]
                cNome        := oJsBody["items"][nFunc]["nome"]
                cMat         := oJsBody["items"][nFunc]["matricula"]

                cMailHtml := self:montaHtmlEmail(oJsBody["items"][nFunc]["residuos"], cMailAssunto, cMat, cNome)

                //Envio do e-mail
                If GPEMail(cMailAssunto, cMailHtml, cEmail)
                    lRet := .F.
                    for nResiduo := 1 to len(oJsBody["items"][nFunc]["residuos"])
                        cChave := PadR(oJsBody["items"][nFunc]["residuos"][nResiduo]["branchCodeResi"],TamSX3("RCK_FILIAL")[1]) + ;
                            oJsBody["items"][nFunc]["residuos"][nResiduo]["matriculaResi"] + ;
                            PadR(oJsBody["items"][nFunc]["residuos"][nResiduo]["id"],TamSX3("RCK_NUMID")[1])
                        cStatusResiduo := If(oJsBody["items"][nFunc]["residuos"][nResiduo]["statusResiduo"] == 'enviado', '2', '1')
                        lRet := self:atualizarStatus(cChave, cStatusResiduo, oJsBody["items"][nFunc]["residuos"][nResiduo]["periodo"])   
                        If lRet    
                            oItem := JSonObject():new()  
                            oItem["key"]      := trim(oJsBody["items"][nFunc]["residuos"][nResiduo]["branchCodeResi"])+trim(oJsBody["items"][nFunc]["residuos"][nResiduo]["matriculaResi"])
                            oItem["id"]       := oJsBody["items"][nFunc]["residuos"][nResiduo]["id"]
                            oItem["periodo"]  := oJsBody["items"][nFunc]["residuos"][nResiduo]["periodo"]
                            oItem["statusResiduo"]  := If(cStatusResiduo == "2", "nao_enviado", 'enviado')                        
                            aAdd(oResponse["items"], oItem) 
                        EndIf	
                    Next nResiduo
                Else
                    oJsBadResp := JSonObject():new()
                    oJsBadResp['code']    := CodeRespBadRequest
                    oJsBadResp['message'] := EncodeUTF8(OemToAnsi("E-mail(s) não enviado(s). Verifique a configuração de E-mail/Proxy no Configurador."))
                    oRest:setStatusCode(CodeRespBadRequest)
                    oRest:setResponse(oJsBadResp:toJson())  
                    return
                EndIf
            EndIf
        Next nFunc  

    EndIf  
    oRest:setStatusCode(CodeRespCreated)
    oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return 

/*-------------------------------------------------------------------
{Protheus.doc} Post setStatusResiduo
Serviço para atualizar o status e-mail de um registro 

@author	Maria Luísa de Souza Arcanjo Bastos
@since	30/01/2026
-------------------------------------------------------------------*/
method setStatusResiduo() class GPEResiduoCreditoTrabalhador

    Local cStatusResiduo as Character
    Local cChave as Character
    Local lRet as Logical
    Local oItem	as Object
    Local oResponse := JsonObject():New() as Json
    Local oJsBody := JsonObject():new() as Json

    oJsBody:fromJson( oRest:GetBodyRequest() )
	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oResponse["items"] := {}

    If Valtype(oJsBody) != "U" 
        cStatusResiduo := If(oJsBody["statusResiduo"] == 'enviado', '2', '1')
        cChave := PadR(oJsBody["branchCodeResi"],TamSX3("RCK_FILIAL")[1]) + oJsBody["matriculaResi"] + PadR(oJsBody["id"],TamSX3("RCK_NUMID")[1])
        
        lRet := self:atualizarStatus(cChave, cStatusResiduo, oJsBody["periodo"])   
        
        If lRet          
            oItem := JSonObject():new()
            oItem["key"]      := trim(oJsBody["branchCodeResi"])+trim(oJsBody["matriculaResi"])
            oItem["id"]       := oJsBody["id"]
            oItem["periodo"]  := oJsBody["periodo"]
            oItem["statusResiduo"]  := If(cStatusResiduo == "2", "nao_enviado", 'enviado')
            aAdd(oResponse["items"], oItem)   
        EndIf	
    
    EndIf     
    oRest:setStatusCode(CodeRespCreated)
    oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} Get getListaResiduos
API de busca lista de funcionarios com residuo de credito do trabalhador

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method getListaResiduos() class GPEResiduoCreditoTrabalhador

    Local aBranches as array   
    Local cLastFil as Character
    Local cAlias as Character		
    Local cQuery as Character
    Local cPerDe as Character
    Local cPerAte as Character
    Local cChave as Character
    Local cUltPerFec as Character
    Local cStatus as Character
    Local cValidFil as Character
    Local cAcessaSRA as Character
    Local jParams := oRest:getQueryRequest() as Json
    Local lHasNext as Logical
    Local lFiltroIni as Logical
    Local lFitraNaoEnv as Logical
    Local nPageSize as Numeric
    Local nPOrder as Numeric
    Local nStart as Numeric
    Local nPage as Numeric
    Local nEnd as Numeric
    Local oItem	as Object
    Local oItemRes	as Object
    Local oResponse := JsonObject():New() as Json
    Local aValidFil as Array
    Local nI as Numeric
    
    Static oStatementFunc

    oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    cValidFil    := fValidFil()
    aBranches    := IIf(jParams:hasProperty("branchCode"), If(jParams['branchCode'] <> '', StrTokArr(jParams['branchCode'], ','), {cFilAnt}), {cFilAnt})//IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {cFilAnt}) //Filial corrente
    cPerDe       := IIf(jParams:hasProperty("periodoDe"), If(jParams['periodoDe'] < '202505', '202505', jParams['periodoDe']), cUltPerFec := self:getUltPerFec())
    cPerAte      := IIf(jParams:hasProperty("periodoAte"), jParams['periodoAte'], cUltPerFec) 
    cAcessaSRA   := &("{ || " + ChkRH("GPEA010", "SRA","2") + "}")
    lFitraNaoEnv := IIf(jParams:hasProperty("exibeEnv"), If(jParams['exibeEnv'] == "true", .F., .T.), .T.)// se não exibe enviados, filtra somente não enviados == 2
    lFiltroIni   := IIf(jParams:hasProperty("isFiltroIni"),.T.,.F.)
    nPage 	     := Val(jParams["page"])
    nPageSize    := Val(jParams["pageSize"])
    nPOrder      := 1
    nStart := (nPage - 1) * nPageSize + 1
    nEnd   :=  nPage * nPageSize + 1

    aValidFil := StrTokArr(cValidFil, "/")
    
    For nI := Len(aBranches) To 1 Step -1    
        If (aScan(aValidFil, {|x| AllTrim(x) == AllTrim(aBranches[nI])})) == 0     
            aDel(aBranches, nI)
            aSize(aBranches, Len(aBranches)-1)
        EndIf
    Next nI

    oResponse["items"] := {}
    
    If oStatementFunc == Nil .Or. nStart == 1  
        
        cQuery += " SELECT PAG.LINHA, SRA.RA_FILIAL, SRA.RA_MAT, SRA.RA_NOME, SRA.RA_NSOCIAL, SRA.RA_NOMECMP, SRA.RA_EMAIL, "
        cQuery += "     RCK.RCK_PER, RCK.RCK_MAIL, RCK.RCK_PD, RCK.RCK_VLPAGO, RCK.RCK_NPAG, RCK.RCK_PARCPG, RCK.RCK_NUMID,"
        cQuery += "     SRK.RK_NRCONTR, SRK.RK_PARCELA, SRK.RK_VALORTO, SRK.RK_VALORPA, SRK.RK_BCOCONS"
        cQuery += " FROM ( SELECT RA_FILIAL, RA_MAT, P.LINHA FROM ( "
        cQuery += "     SELECT RA_FILIAL, RA_MAT, ROW_NUMBER() OVER (ORDER BY RA_FILIAL, RA_MAT) AS LINHA "
        cQuery += "     FROM "+RetSqlName("SRA")+" SRA "
        cQuery += "     WHERE SRA.D_E_L_E_T_ = ? AND SRA.RA_FILIAL IN (?) "
        cQuery += "     AND EXISTS ( "
        cQuery += "         SELECT 1 FROM "+RetSqlName("SRK")+" SRK  "
        cQuery += "         INNER JOIN "+RetSqlName("RCK")+" RCK ON RCK.RCK_FILIAL = SRK.RK_FILIAL AND RCK.RCK_NUMID = SRK.RK_NUMID AND RCK.D_E_L_E_T_ = ? AND RCK.RCK_NPAG > ? AND RCK.RCK_PER BETWEEN ? AND ? "
        cQuery += "         WHERE SRK.RK_FILIAL = SRA.RA_FILIAL AND SRK.RK_MAT = SRA.RA_MAT AND SRK.D_E_L_E_T_ = ? AND SRK.RK_NRCONTR <> ? AND SRK.RK_CONSFGT = ?
        If lFitraNaoEnv
            cQuery += "         AND RCK.RCK_MAIL <> ? "
        EndIf
        cQuery += "         )) P "
        cQuery += " WHERE P.LINHA BETWEEN ? AND ?) PAG "
        cQuery += " INNER JOIN "+RetSqlName("SRA")+" SRA ON SRA.RA_FILIAL = PAG.RA_FILIAL AND SRA.RA_MAT = PAG.RA_MAT AND SRA.D_E_L_E_T_ = ? "
        cQuery += " INNER JOIN "+RetSqlName("SRK")+" SRK ON SRK.RK_FILIAL = SRA.RA_FILIAL AND SRK.RK_MAT = SRA.RA_MAT AND SRK.D_E_L_E_T_ = ? AND SRK.RK_NRCONTR <> ? AND SRK.RK_CONSFGT = ? "
        cQuery += " INNER JOIN "+RetSqlName("RCK")+" RCK ON RCK.RCK_FILIAL = SRK.RK_FILIAL AND RCK.RCK_NUMID  = SRK.RK_NUMID AND RCK.D_E_L_E_T_ = ? AND RCK.RCK_NPAG > ? AND RCK.RCK_PER BETWEEN ? AND ? "
        If lFitraNaoEnv
            cQuery += " AND RCK.RCK_MAIL <> ? "
        EndIf
        cQuery         := ChangeQuery(cQuery) 
        oStatementFunc := FwExecStatement():New(cQuery)
    EndIf

    oStatementFunc:SetString(nPOrder++, '')  
    oStatementFunc:SetIn(nPOrder++, aBranches)  
    oStatementFunc:SetString(nPOrder++, '') 
    oStatementFunc:SetNumeric(nPOrder++, 0)     
    oStatementFunc:SetString(nPOrder++, cPerDe)            
    oStatementFunc:SetString(nPOrder++, cPerAte) 
    oStatementFunc:SetString(nPOrder++, '')  
    oStatementFunc:SetString(nPOrder++, '')  
    oStatementFunc:SetString(nPOrder++, '1')    
    If lFitraNaoEnv
        oStatementFunc:SetString(nPOrder++, '1')
    EndIf
    oStatementFunc:SetString(nPOrder++, cValToChar(nStart))
    oStatementFunc:SetString(nPOrder++, cValToChar(nEnd))
    oStatementFunc:SetString(nPOrder++, '') 
    oStatementFunc:SetString(nPOrder++, '')  
    oStatementFunc:SetString(nPOrder++, '')  
    oStatementFunc:SetString(nPOrder++, '1')
    oStatementFunc:SetString(nPOrder++, '') 
    oStatementFunc:SetNumeric(nPOrder++, 0)
    oStatementFunc:SetString(nPOrder++, cPerDe)            
    oStatementFunc:SetString(nPOrder++, cPerAte)
    If lFitraNaoEnv
        oStatementFunc:SetString(nPOrder++, '1')
    EndIf

    cAlias := oStatementFunc:OpenAlias()

    While !(cAlias)->(Eof())
        If (cAlias)->LINHA > (nEnd - 1)
            lHasNext := .T.
            Exit 
        EndIf   

        If cLastFil != (cAlias)->RA_FILIAL
            If !((cAlias)->RA_FILIAL $ cValidFil) .Or. !Eval(cAcessaSRA) 
				(cAlias)->( dbSkip() )
				Loop
			EndIf
            cLastFil := (cAlias)->RA_FILIAL 
        EndIf
        
        If cChave != (cAlias)->RA_FILIAL+(cAlias)->RA_MAT 
            cChave := (cAlias)->RA_FILIAL+(cAlias)->RA_MAT  

            oItem := JsonObject():new()               

            oItem["branchCode"]	:= RTrim((cAlias)->RA_FILIAL)
            oItem["matricula"]  := RTrim((cAlias)->RA_MAT)
            oItem["nome"]	    := RTrim(IIf(!Empty((cAlias)->RA_NSOCIAL), (cAlias)->RA_NSOCIAL, IIf(!Empty((cAlias)->RA_NOMECMP), (cAlias)->RA_NOMECMP, (cAlias)->RA_NOME)))
            oItem["email"] 	    := Rtrim((cAlias)->RA_EMAIL) 
            cStatus             := If(Empty((cAlias)->RCK_MAIL), "2", (cAlias)->RCK_MAIL)
            oItem["residuos"]   := {}
        Else
            If cStatus != ( If(Empty((cAlias)->RCK_MAIL), "2", (cAlias)->RCK_MAIL) )
                cStatus := "3"
            EndIf
        EndIf
        
        oItemRes := JSonObject():new()
        oItemRes["branchCodeResi"] := RTrim((cAlias)->RA_FILIAL)
        oItemRes["matriculaResi"]  := RTrim((cAlias)->RA_MAT)
        oItemRes["periodo"]  := Rtrim((cAlias)->RCK_PER)
        oItemRes["id"]       := Rtrim((cAlias)->RCK_NUMID)
        oItemRes["contrato"] := Rtrim((cAlias)->RK_NRCONTR)
        oItemRes["banco"]    := Rtrim((cAlias)->RK_BCOCONS)
        oItemRes["tot_parc"] := cValToChar((cAlias)->RCK_PARCPG)+" de "+cValToChar((cAlias)->RK_PARCELA)    
        oItemRes["tot_val"]  := (cAlias)->RK_VALORTO
        oItemRes["parcela"]  := (cAlias)->RK_VALORPA
        oItemRes["residuo"]  := (cAlias)->RCK_NPAG
        oItemRes["statusResiduo"]  := If((cAlias)->RCK_MAIL == "1", "enviado","nao_enviado")

        Aadd(oItem["residuos"], oItemRes)
        
        (cAlias)->(DbSkip())

        If (cAlias)->(Eof()) .or. cChave != (cAlias)->RA_FILIAL+(cAlias)->RA_MAT  
            oItem["status"] := If(cStatus == "1", "enviado", If(Empty(cStatus) .Or. cStatus == "2","nao_enviado", "parcialmente_enviado"))
            Aadd(oResponse["items"], oItem)            
        EndIf
    EndDo

    (cAlias)->(dbCloseArea())
    If lFiltroIni
        oResponse["branchCode"] := cFilAnt
        oResponse["filtroCPerDe"] := cPerDe
        oResponse["filtroCPerAte"] := cPerAte
    EndIf
    oResponse["exibeEnv"]  := !lFitraNaoEnv
    oResponse["hasNext"]   := lHasNext 
    oResponse["totalResiduos"] := self:getTotalResiduos(aBranches, cPerDe, cPerAte, lFitraNaoEnv, cValidFil)

    oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return
 

/*-------------------------------------------------------------------
{Protheus.doc} Get getUltPerFec
Método para retornar último período fechado da filial logada

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method getUltPerFec() as character class GPEResiduoCreditoTrabalhador

    Local cAlias as Character      
    Local cDb := TcGetDb() as Character 
    Local cQuery as Character
    Local cRet as Character 
    Local nPOrder as Numeric

    Static oStatement

    nPOrder := 1

    If oStatement == Nil 
        cQuery := " SELECT RCH.RCH_PER FROM " + RetSqlName("RCH") + " RCH "
        cQuery += " WHERE RCH.RCH_DTFECH IS NOT NULL AND RCH.RCH_STATUS = ? AND RCH.RCH_FILIAL = ? "
        cQuery += " AND RCH.RCH_ROTEIR = ? "
        cQuery += " ORDER BY R_E_C_N_O_ DESC "
        cQuery += If(cDb == "POSTGRESQL", " LIMIT 1 ", " OFFSET 0 ROWS FETCH FIRST 1 ROWS ONLY ")

        cQuery     := ChangeQuery(cQuery) 
        oStatement := FwExecStatement():New(cQuery)
    EndIf

    If(cDb == "POSTGRESQL", oStatement:SetString(nPOrder++, '5'), oStatement:SetNumeric(nPOrder++, 5))
    oStatement:SetString(nPOrder++, xFilial("RCH"))
    oStatement:SetString(nPOrder++, 'FOL')

    cAlias := oStatement:OpenAlias()

    If !(cAlias)->(Eof())
        cRet := (cAlias)->RCH_PER 
    EndIf

    (cAlias)->(dbCloseArea())

return If(Empty(cRet), "202505", cRet)

/*-------------------------------------------------------------------
{Protheus.doc} Get getFiliais
Serviço para retornar uma lista de filiais da SM0

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method getFiliais() class GPEResiduoCreditoTrabalhador
    
    Local cSearch as Character
    Local jParams := oRest:getQueryRequest() as Json
    Local lHasNext as Logical
    Local nPageSize as Numeric
    Local nCount as Numeric
    Local nStart as Numeric
    Local nPage as Numeric
    Local nEnd as Numeric
    Local nI as Numeric
    Local oItem	as Object
    Local oResponse := JsonObject():New() as Json

    DEFAULT aSM0 := FwLoadSM0()

    cSearch   := IIf(jParams:hasProperty("filter"), jParams["filter"], "")
    nPage     := Val(jParams["page"])
    nPageSize := Val(jParams["pageSize"])

    oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    nStart := (nPage - 1) * nPageSize + 1
    nEnd   :=  nPage * nPageSize

    oResponse["items"] := {}

    For nI := 1 To Len(aSM0)
        If (aSM0[nI][SM0_GRPEMP] != cEmpAnt)
            LOOP
        EndIf

        If (!Empty(cSearch) .And. !(Upper(cSearch) $ Upper(aSM0[nI][SM0_CODFIL])) .And. !(Upper(cSearch) $ Upper(aSM0[nI][SM0_NOMRED])))
            LOOP
        EndIf

        nCount++
        If nCount < nStart
            LOOP
        EndIf
        
        If nCount > nEnd .And. Empty(cSearch)
            lHasNext := .T.
            Exit
        EndIf

        oItem := JSonObject():new()
        oItem["branchCode"] := AllTrim(aSM0[nI][SM0_CODFIL])
        oItem["branchName"] := AllTrim(aSM0[nI][SM0_NOMRED])

        aadd(oResponse["items"], oItem)

    Next nI

    oResponse["hasNext"] := lHasNext 

    oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} Get getFilial
Serviço para retornar uma filial na digitação do lookup

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method getFilial() class GPEResiduoCreditoTrabalhador
    
    Local cGetFil as Character
    Local jFil := oRest:getPathParamsRequest() as Json
    Local nPos as Numeric
    Local oItem	as Object
    Local oResponse := JsonObject():New() as Json

    DEFAULT aSM0 := FwLoadSM0()

    cGetFil := IIf(jFil:hasProperty("filial"), jFil["filial"], "")

    oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    oResponse["items"] := {}

    If !Empty(cGetFil)
        If Len(aSM0) > 0
            nPos := aScan( aSM0, { |x| x[1] == cEmpAnt .And. Upper(AllTrim(x[2])) == Upper(AllTrim(cGetFil))} )
            If nPos > 0
                oItem := JSonObject():new()
                oItem["branchCode"]	:= AllTrim(aSM0[nPos][SM0_CODFIL])
                oItem["branchName"]	:= AllTrim(aSM0[nPos][SM0_NOMRED])
                aadd(oResponse["items"], oItem)
            EndIf
        EndIf
    EndIf

    oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} atualizarStatus
Método para posicionar no registro da tabela e atualizar o campo

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method atualizarStatus(cChave, cStatus, cPeriodo) as logical class GPEResiduoCreditoTrabalhador

    Local lRet as Logical

    dbSelectArea("RCK")  
    RCK->(dbSetOrder(RetOrder("RCK","RCK_FILIAL+RCK_MAT+RCK_NUMID")))
    RCK->(DbGoTop())	
    If RCK->(dbSeek(cChave))
        While RCK->(!Eof()) .And. cChave == RCK->RCK_FILIAL + RCK->RCK_MAT + RCK->RCK_NUMID 
            If cPeriodo == RCK->RCK_PER
                lRet := .T.                       
                RCK->(RecLock("RCK", .F.))
                RCK->RCK_MAIL	:= cStatus
                RCK->(MsUnlock()) 
                Exit
            EndIf
            RCK->(DbSkip())               
        EndDo        
    EndIf	

return lRet

/*-------------------------------------------------------------------
{Protheus.doc} montaHtmlEmail
Método para montar o html do e-mail a ser enviado

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method montaHtmlEmail(oItem, cTitulo, cMat, cNome) as character class GPEResiduoCreditoTrabalhador

    Local cHtml as Character
    Local nResiduo as Numeric

    cHtml := '<html>'
    cHtml += '<body style="font-family:Arial, Helvetica, sans-serif; background-color:#f4f6f8; padding:20px;">'

    cHtml += '<table width="100%" cellpadding="0" cellspacing="0">'
    cHtml += '<tr><td align="center">'

    cHtml += '<table width="700" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:6px;">'

    /* Cabeçalho */
    cHtml += '<tr>'
    cHtml += '<td style="background-color:#003366; color:#ffffff; padding:20px;">'
    cHtml += '<h2 style="margin:0;">'+cTitulo+'</h2>'
    cHtml += '</td>'
    cHtml += '</tr>'

    /* Conteúdo */
    cHtml += '<tr><td style="padding:20px; color:#333333;">'
    cHtml += '<p>Prezado(a),</p>'
    cHtml += '<p>Identificamos a existência de <strong>resíduo(s) de empréstimo consignado</strong>:</p>'
    cHtml += '<p><strong>Funcionário:</strong> ' + cMat + ' - ' + cNome + '</p>'

    /* Tabela */
    cHtml += '<table width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse; margin-top:15px;">'
    cHtml += '<tr style="background-color:#e6eef6;">'
    cHtml += '<th style="border:1px solid #cccccc;">Período</th>'
    cHtml += '<th style="border:1px solid #cccccc;">Parcelas</th>'
    cHtml += '<th style="border:1px solid #cccccc;">Valor Total</th>'
    cHtml += '<th style="border:1px solid #cccccc;">Parcela</th>'
    cHtml += '<th style="border:1px solid #cccccc;">Resíduo</th>'
    cHtml += '<th style="border:1px solid #cccccc;">Contrato</th>'
    cHtml += '<th style="border:1px solid #cccccc;">Inst. Finan.</th>'
    cHtml += '</tr>'

    For nResiduo := 1 To len(oItem)

        cHtml += '<tr>'
        cHtml += '<td style="border:1px solid #cccccc; text-align:center;">' + oItem[nResiduo]["periodo"] + '</td>'
        cHtml += '<td style="border:1px solid #cccccc; text-align:center;">' + oItem[nResiduo]["tot_parc"] + '</td>'
        cHtml += '<td style="border:1px solid #cccccc; text-align:right;">' + ;
            self:formataMoeda(oItem[nResiduo]["tot_val"]) + '</td>'
        cHtml += '<td style="border:1px solid #cccccc; text-align:right;">' + ;
            self:formataMoeda(oItem[nResiduo]["parcela"]) + '</td>'
        cHtml += '<td style="border:1px solid #cccccc; text-align:right; color:#c00000;"><strong>' + ;
            self:formataMoeda(oItem[nResiduo]["residuo"]) + '</strong></td>'
        cHtml += '<td style="border:1px solid #cccccc; text-align:center;">' + oItem[nResiduo]["contrato"] + '</td>'
        cHtml += '<td style="border:1px solid #cccccc; text-align:center;">' + oItem[nResiduo]["banco"] + '</td>'
        cHtml += '</tr>'

    Next nResiduo

    cHtml += '</table>'

    /* Aviso */
    cHtml += '<div style="margin-top:20px; padding:15px; background-color:#fff3cd; border:1px solid #ffeeba; color:#856404;">'
    cHtml += '<strong>ATENÇÃO TRABALHADOR</strong><br><br>'
    cHtml += 'Não foi possível realizar o desconto total ou parcial do seu empréstimo consignado, '
    cHtml += 'pois o valor excede o percentual máximo permitido (35%) da remuneração disponível, '
    cHtml += 'conforme a Lei nº 10.820/2003 e Portaria MTE nº 435/2025.<br><br>'
    cHtml += 'Entre em contato com sua instituição financeira para regularizar a situação.'
    cHtml += '</div>'

    cHtml += '</td></tr>'
    cHtml += '</table>'

    cHtml += '</td></tr></table>'
    cHtml += '</body></html>'

return cHtml

/*-------------------------------------------------------------------
{Protheus.doc} formataMoeda
Método para transformar os valores numéricos em moeda

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method formataMoeda(nValor) as character class GPEResiduoCreditoTrabalhador
return "R$ " + Transform(nValor, "@E 9,999,999,999.99")


/*-------------------------------------------------------------------
{Protheus.doc} Get getTotalResiduos 
Método para retornar o total de funcionarios com residuo filtrados

@author	Maria Luisa de Souza Arcanjo Bastos
@since	14/01/2026
-------------------------------------------------------------------*/
method getTotalResiduos(aFiliais, cPeriodoDe, cPeriodoAte, lFitraNaoEnv) as numeric class GPEResiduoCreditoTrabalhador
    
    Local cAlias as Character		
    Local cQuery as Character
    Local cDb := TcGetDb() as Character
    Local cConcat as Character
    Local nPOrder as Numeric
    Local nRet as Numeric

    Static oStatementTot 

    nPOrder   := 1
    cConcat   := If(cDb == "MSSQL", " + ", " || ")// SQL Server usa +, Oracle e Postgres usam ||
    
    If oStatementTot == Nil
        cQuery := " SELECT COUNT(DISTINCT RCK.RCK_FILIAL " + cConcat + " RCK.RCK_NUMID " + cConcat + " RCK.RCK_PER " + cConcat + " RCK.RCK_PD) AS TOTAL_RESIDUOS "
        cQuery += " FROM " + RetSqlName("RCK") + " RCK "
        cQuery += " INNER JOIN "+RetSqlName("SRK")+" SRK ON SRK.RK_FILIAL = RCK.RCK_FILIAL AND SRK.RK_NUMID  = RCK.RCK_NUMID  AND SRK.D_E_L_E_T_ = ? AND SRK.RK_NRCONTR <> ? AND SRK.RK_CONSFGT = ? "
        cQuery += " INNER JOIN "+RetSqlName("SRA")+" SRA ON SRA.RA_FILIAL = SRK.RK_FILIAL AND SRA.RA_MAT = SRK.RK_MAT AND SRA.D_E_L_E_T_ = ? "
        cQuery += " WHERE RCK.D_E_L_E_T_ = ? AND RCK.RCK_NPAG > ? AND RCK.RCK_PER BETWEEN ? AND ? AND SRA.RA_FILIAL IN (?) "
        If lFitraNaoEnv
            cQuery += " AND RCK.RCK_MAIL <> ? "
        EndIf
        cQuery     := ChangeQuery(cQuery) 
        oStatementTot := FwExecStatement():New(cQuery)
    EndIf

    oStatementTot:SetString(nPOrder++, ' ')       
    oStatementTot:SetString(nPOrder++, ' ')       
    oStatementTot:SetString(nPOrder++, '1')  
    oStatementTot:SetString(nPOrder++, ' ') 
    oStatementTot:SetString(nPOrder++, ' ')    
    oStatementTot:SetNumeric(nPOrder++, 0) 
    oStatementTot:SetString(nPOrder++, cPeriodoDe)       
    oStatementTot:SetString(nPOrder++, cPeriodoAte)  
    oStatementTot:SetIn(nPOrder++, aFiliais)
    If lFitraNaoEnv
        oStatementTot:SetString(nPOrder++, '1')
    EndIf

    cAlias := oStatementTot:OpenAlias()

    While !(cAlias)->(Eof())
        nRet := (cAlias)->TOTAL_RESIDUOS
        Exit   
    EndDo

    oStatementTot := Nil

    (cAlias)->(dbCloseArea())

return nRet

