#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#Include "totvs.ch"
#Include "rh.sigagpe.gestao.ch"

#DEFINE CodeRespCreated 201
#DEFINE CodeRespBadRequest 400

Static aFilValid
Static __cValidFil

class GPEGestao

	public method new() as object
	
	@POST(endpoint='/api/rh/v1/rhgestao/configuracoes', description='API de gravação das configurações auxiliares da rotina') 
	public method postConfigRhGestao() as object
	
	@POST(endpoint='/api/rh/v1/rhgestao/processa/calculo', description='API de envio da requisição de cálculo para o Protheus') 
	public method postCalcRhGestao() as object

	@POST(endpoint='/api/rh/v1/rhgestao/processa/integra', description='API de envio da requisição de integração para o Protheus') 
	public method postIntegraRhGestao() as object

	@POST(endpoint='/api/rh/v1/rhgestao/processa/fechamento', description='API de envio da requisição de fechamento de período para o Protheus') 
	public method postFechamentoRhGestao() as object	

	@POST(endpoint='/api/rh/v1/rhgestao/relatorio', description='API de envio da requisição para geração do relatorio') 
	public method postRelatorioRhGestao() as object	

	@Get(endpoint='/api/rh/v1/rhgestao/lista', description='Lista os roteiros ativos') 
	public method getListaRot() as object

	@Get(endpoint='/api/rh/v1/rhgestao/pergunte', description='Lista de parametros utilizados no cálculo') 
	public method getListaSx1() as object	

	@Get(endpoint='/api/rh/v1/rhgestao/branches', description='API de busca das filiais da SM0') 
	public method getFiliaisRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/matricula', description='API de busca das matrículas dos funcionários') 
	public method getMatRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/ccusto', description='API de busca dos centros de custo da CTT') 
	public method getCcRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/departamento', description='API de busca dos departamentos da SQB') 
	public method getDeptoRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/funcao', description='API de busca das funções da SRJ') 
	public method getFuncaoRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/opcoes', description='API de busca do combo de opções para filtro do funcionário') 
	public method getOpcoesRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/verbas', description='API de busca das verbas da SRV') 
	public method getVerbaRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/configuracoes', description='API de busca das configurações auxiliares da rotina') 
	public method getConfigRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/status', description='API que retorna o status das execuções em segundo plano') 
	public method getStatusRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/processos', description='API de busca dos processos de cálculo') 
	public method getProcessoRhGestao() as object
	
	@Get(endpoint='/api/rh/v1/rhgestao/roteiros', description='API de busca dos roteiros de cálculo') 
	public method getRoteiroRhGestao() as object

	@Get(endpoint='/api/rh/v1/rhgestao/mensagens', description='API de busca das mensagens da RCC') 
	public method getMensagensGestao() as object

	private method getStatus() as character

	private method getFilVld() as array

	private method getLogProc() as array

endclass

method new() as object class GPEGestao
return self

/*
{Protheus.doc} Get getListaRot
Serviço para retornar lista roteiros ativos
@author	Leandro Drumond
@since	17/10/2025
*/
method getListaRot() class GPEGestao
local oStRoteiro as object
local oItem	as object
local oResponse := JsonObject():New() as Json
local cAlias as character		
local cQuery as character 
local cJoinRCH as character 
local cJoinSRC as character
local cLastFil as character
local cPergunte as character
local lContinua as logical 

cJoinRCH  := FwJoinFilial("RCH", "SRY")
cJoinSRC  := FwJoinFilial("RCH", "SRC")
cLastFil  := "*"

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

oResponse["items"] := {}

cQuery := "SELECT RCH.RCH_FILIAL, RCH.RCH_PROCES, RCH.RCH_PER, RCH.RCH_NUMPAG, RCH.RCH_ROTEIR, RCH.RCH_DTINTE," 
cQuery += " SRY.RY_DESC, SRY.RY_INTEGRA, SRY.RY_TIPO, SRY.RY_PERGUNT, COUNT(SRC.RC_MAT) AS CONTADOR "
cQuery += " FROM " + RetSqlName("RCH") + " RCH "
cQuery += " INNER JOIN " + RetSqlName("SRY") + " SRY ON " + cJoinRCH + " AND SRY.RY_CALCULO = RCH.RCH_ROTEIR AND SRY.D_E_L_E_T_ = ? ""
cQuery += " LEFT JOIN " + RetSqlName("SRC") + " SRC ON " + cJoinSRC + " AND SRC.RC_PROCES = RCH.RCH_PROCES AND SRC.RC_PERIODO = RCH.RCH_PER AND SRC.RC_SEMANA = RCH.RCH_NUMPAG AND SRC.RC_ROTEIR = RCH.RCH_ROTEIR AND SRC.D_E_L_E_T_ = ? "
cQuery += " WHERE RCH.D_E_L_E_T_ = ? AND RCH.RCH_PERSEL = ? "
cQuery += " GROUP BY RCH.RCH_FILIAL, RCH.RCH_PROCES, RCH.RCH_PER, RCH.RCH_NUMPAG, RCH.RCH_ROTEIR, RCH.RCH_DTINTE, SRY.RY_DESC, SRY.RY_INTEGRA, SRY.RY_TIPO, SRY.RY_PERGUNT"

cQuery     := ChangeQuery(cQuery) 
oStRoteiro := FwExecStatement():New(cQuery)

oStRoteiro:SetString(1, " ")
oStRoteiro:SetString(2, " ")
oStRoteiro:SetString(3, " ")
oStRoteiro:SetString(4, "1")

cAlias := oStRoteiro:OpenAlias()

While !(cAlias)->(Eof())

	If cLastFil != (cAlias)->RCH_FILIAL
		cLastFil := (cAlias)->RCH_FILIAL
		lContinua := .T.
		DEFAULT __cValidFil := fValidFil()
		If !(Empty((cAlias)->RCH_FILIAL)) .And. !(AllTrim((cAlias)->RCH_FILIAL) $ __cValidFil) 
			lContinua := .F.
		EndIf
	EndIf

	If !lContinua
		(cAlias)->( dbSkip() )
		Loop
	EndIf

	cPergunte := Replace(AllTrim((cAlias)->RY_PERGUNT),"GP020","GP021") //Atualiza pergunta - GP021 é a atual

	If((cAlias)->RY_TIPO == "3") //Férias
		cPergunte := "GPM062A"
	ElseIf ((cAlias)->RY_TIPO == "C") //Plano de saúde - Pergunta é montada pela RCC/RCB e só é usada no GPEM020
		cPergunte := ""
	EndIf

	oItem := JSonObject():new()
	oItem["filial"]    := (cAlias)->RCH_FILIAL
	oItem["processo"]  := (cAlias)->RCH_PROCES
	oItem["periodo"]   := (cAlias)->RCH_PER
	oItem["semana"]    := (cAlias)->RCH_NUMPAG
	oItem["roteiro"]   := (cAlias)->RCH_ROTEIR
	oItem["tipo"]      := (cAlias)->RY_TIPO
	oItem["descricao"] := RTrim((cAlias)->RY_DESC)
	oItem["pergunte"]  := cPergunte
	oItem["status"]    := self:getStatus(cAlias)

	aAdd(oResponse["items"], oItem)
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getListaSx1
Serviço para retornar os grupos de perguntas auxiliares para cálculo (RY_PERGUNT)
@author	Leandro Drumond
@since	22/10/2025
*/
method getListaSx1() class GPEGestao
local oStQuery as object
local oItem	as object
local oResponse := JsonObject():New() as Json
local aRoteiro  := {} as array
local aPergunte := {} as array
local aDefAux 	:= {} as array
local aValAux   := {} as array 
local cValAux as character
local cAlias as character		
local cQuery as character 
local cGrupoAux as character
local cCampoAux as character
local cVariavel as character
local nPos as numeric
local nIndex as numeric

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

oResponse["items"] := {}

cQuery := "SELECT DISTINCT RY_CALCULO, RY_PERGUNT FROM " + RetSqlName("SRY") + " SRY "
cQuery += " WHERE SRY.D_E_L_E_T_ = ? AND SRY.RY_PERGUNT <> ? AND SRY.RY_TIPO <> ? "

cQuery   := ChangeQuery(cQuery) 
oStQuery := FwExecStatement():New(cQuery)

oStQuery:SetString(1, " ")
oStQuery:SetString(2, " ")
oStQuery:SetString(3, "C")

cAlias := oStQuery:OpenAlias()

While !(cAlias)->(Eof())

	cPergunte := AllTrim((cAlias)->RY_PERGUNT)

	cPergunte := Replace(cPergunte,"GP020","GP021") //Atualiza pergunta - GP021 é a atual	

	aAdd(aPergunte, cPergunte)
	aAdd(aRoteiro, (cAlias)->RY_CALCULO)

	(cAlias)->( dbSkip() )
	
EndDo

//Inclui grupo de perguntas de férias programadas
aAdd(aPergunte, "GPM062A")
aAdd(aRoteiro, fGetCalcRot("3"))

(cAlias)->(dbCloseArea())

dbSelectArea("SX1")
dbSetOrder(1)

For nPos := 1 to Len(aPergunte)

	cGrupoAux := AllTrim(aPergunte[nPos])
	
	If SX1->(dbSeek(cGrupoAux))
		
		Pergunte(cGrupoAux,.F.)
		
		While SX1->(!Eof() .And. AllTrim(X1_GRUPO) == AllTrim(cGrupoAux))

			cVariavel := Lower(AllTrim(SX1->X1_VAR01))

			oItem := JSonObject():new()

			oItem["roteiro"]    := aRoteiro[nPos]
			oItem["grupo"]  	:= cGrupoAux
			oItem["ordem"]   	:= SX1->X1_ORDEM
			oItem["pergunta"]   := SX1->X1_PERGUNT
			oItem["variavel"]   := cVariavel
			oItem["tipo"]      	:= SX1->X1_TIPO
			oItem["tamanho"] 	:= SX1->X1_TAMANHO

			aDefAux := {}

			For nIndex := 1 to 5
				cCampoAux := "X1_DEF0" + cValToChar(nIndex)
				If !Empty(SX1->&(cCampoAux))
					aAdd(aDefAux, SX1->&(cCampoAux))
				EndIf
			Next nIndex	
			
			oItem["definicao"]  := aDefAux

			If( cGrupoAux == "GP021VTR" .and. cVariavel $ "mv_par07/mv_par08/mv_par09/mv_par10" .and. Len(AllTrim((&(cVariavel)))) > 0 )
				cValAux := AllTrim((&(cVariavel)))
				aValAux := {}
				For nIndex := 1 To Len(AllTrim(cValAux)) Step 3
					aAdd(aValAux, Subs(cValAux,nIndex,3))		
				Next nIndex
				oItem["valor"]    	:= aValAux
			Else 
				oItem["valor"]    	:= &(cVariavel)
			EndIf

			aAdd(oResponse["items"], oItem)

			SX1->(dbSkip())
		EndDo
	EndIf
	
Next nPos

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getFiliaisRhGestao
Serviço para retornar lista de filiais da SM0
@author	Leandro Drumond
@since	17/10/2025
*/
method getFiliaisRhGestao() class GPEGestao
local oItem	as Object
local jParams := oRest:getQueryRequest() as Json
local oResponse := JsonObject():New() as Json
local aSM0Aux := {} as array
local cSearch as character
local cLastFil as character
local nPageSize as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nI as numeric
local nx as numeric
local lHasNext as logical
local lContinua as logical

Static aSM0

cSearch   := IIf(jParams:hasProperty("filter"), jParams["filter"], "")
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := (nPage - 1) * nPageSize + 1
nEnd   :=  nPage * nPageSize + 1
nI     := If(Empty(cSearch) .And. nStart > 1, nStart, 1)

If aSM0 == Nil
	aSM0    := {}
	aSM0Aux := FwLoadSM0()

	For nX := 1 To Len(aSM0Aux) //Limpa grupos que não serão utilizados para não exibir tela vazia devido a 'hasnext'
		If (aSM0Aux[nX][SM0_GRPEMP] != cEmpAnt)
			Loop
		EndIf

		aAdd(aSM0, aSM0Aux[nX])
	Next nI
EndIf

oResponse["items"] := {}

For nI := nI To Len(aSM0)
	If nI > (nEnd - 1) .And. Empty(cSearch)
		lHasNext := .T.
		Exit 
	EndIf   

	If (!Empty(cSearch) .And. !(Upper(cSearch) $ Upper(aSM0[nI][SM0_CODFIL])) .And. !(Upper(cSearch) $ Upper(aSM0[nI][SM0_NOMRED])))
		Loop
	EndIf

	If cLastFil != aSM0[nI][SM0_CODFIL]
		cLastFil := aSM0[nI][SM0_CODFIL]
		lContinua := .T.
		DEFAULT __cValidFil := fValidFil()
		If !(AllTrim(aSM0[nI][SM0_CODFIL]) $ __cValidFil) 
			lContinua := .F.
		EndIf
	EndIf

	If !lContinua
		Loop 
	EndIf

	oItem := JSonObject():new()
	oItem["branchCode"]	:= EncodeUTF8(aSM0[nI][SM0_CODFIL])
	oItem["branchName"]	:= EncodeUTF8(AllTrim(aSM0[nI][SM0_NOMRED]))

	aadd(oResponse["items"], oItem)

Next nI

oResponse["hasNext"] := lHasNext 

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getMatRhGestao
Serviço para retornar lista de matrículas para consulta padrao
@author	Leandro Drumond
@since	17/10/2025
*/
method getMatRhGestao() class GPEGestao
local oItem	as Object
local jParams := oRest:getQueryRequest() as Json
local oResponse := JsonObject():New() as Json
local cSearch as character
local cAlias as character		
local cQuery as character
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local lHasNext as logical
local aFilPar as array

Static __cEmpAntMat := cEmpAnt
Static oStatementMat

cSearch   := IIf(jParams:hasProperty("filter"), jParams["filter"], "")
aFilPar   := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams["branchCode"], ","), {})
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])
nPOrder   := 1

If Empty(aFilPar)
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid := self:getFilVld(StrTokArr(__cValidFil, "/"))
	aFilPar := aClone(aFilValid)
EndIf

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := If(!Empty(cSearch), 1, (nPage - 1) * nPageSize + 1)
nEnd   := nPage * nPageSize + 1

oResponse["items"] := {}

If oStatementMat == Nil .Or. __cEmpAntMat <> cEmpAnt .Or. nStart == 1 .Or. !Empty(cSearch)
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY SRA.RA_FILIAL, SRA.RA_MAT ASC) AS LINHA, "
	cQuery += " SRA.RA_FILIAL, SRA.RA_MAT, SRA.RA_NOME, SRA.RA_NOMECMP "
	cQuery += " FROM " + RetSqlName("SRA") + " SRA "
	cQuery += " WHERE " + If(!Empty(cSearch), "(SRA.RA_FILIAL LIKE ? OR SRA.RA_MAT LIKE ? OR SRA.RA_NOMECMP LIKE ? OR SRA.RA_NOME LIKE ?) AND ", "") 
	If !Empty(aFilPar)
		cQuery += "SRA.RA_FILIAL IN (?) AND "
	EndIf
	cQuery += "SRA.D_E_L_E_T_ = ?"
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	__cEmpAntMat  := cEmpAnt
	cQuery        := ChangeQuery(cQuery) 
	oStatementMat := FwExecStatement():New(cQuery)
EndIf

If !Empty(cSearch)
	oStatementMat:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementMat:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementMat:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementMat:SetString(nPOrder++, "%"+cSearch+"%")
EndIf
If !Empty(aFilPar)
	oStatementMat:SetIn(nPOrder++, aFilPar)
EndIf
oStatementMat:SetString(nPOrder++, " ")
oStatementMat:SetString(nPOrder++, cValToChar(nStart))
oStatementMat:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStatementMat:OpenAlias()
dbSelectArea(cAlias)

While !(cAlias)->(Eof())

	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf

	oItem := JSonObject():new()
	oItem["filMat"]	 := EncodeUTF8((cAlias)->RA_FILIAL)
	oItem["matCode"] := EncodeUTF8((cAlias)->RA_MAT)
	oItem["matName"] := FwHttpEncode(RTrim(IIf(!Empty((cAlias)->RA_NOMECMP), (cAlias)->RA_NOMECMP, (cAlias)->RA_NOME)))

	aadd(oResponse["items"], oItem)
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext

oRest:setResponse(oResponse:toJson())

return

/*
{Protheus.doc} Get getCcRhGestao
Serviço para retornar lista de centros de custo para consulta padrao
@author	Leandro Drumond
@since	17/10/2025
*/
method getCcRhGestao() class GPEGestao
local oItem	as Object
local jParams := oRest:getQueryRequest() as Json
local oResponse := JsonObject():New() as Json
local cSearch as character
local cAlias as character		
local cQuery as character 
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nTam as numeric
local nI as numeric
local lHasNext as logical
local aFilPar as array

Static __cEmpAntCC := cEmpAnt
Static oStatementCC

cSearch   := IIf(jParams:hasProperty("filter"), jParams["filter"], "")
aFilPar   := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams["branchCode"], ","), {})
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])
nPOrder   := 1

If Empty(aFilPar)
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid := self:getFilVld(StrTokArr(__cValidFil, "/"))
	aFilPar := aClone(aFilValid)
EndIf

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := (nPage - 1) * nPageSize + 1
nEnd   :=  nPage * nPageSize + 1
oResponse["items"] := {}

If Len(Rtrim(xFilial("CTT"))) > 0
	nTam := Len(Rtrim(xFilial("CTT")))
	For nI := 1 To Len(aFilPar)
      	aFilPar[nI] := SubStr(aFilPar[nI], 1, nTam)
	Next nI
EndIf

If oStatementCC == Nil .Or. __cEmpAntCC <> cEmpAnt .Or. nStart == 1
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY CTT.CTT_FILIAL, CTT.CTT_CUSTO ASC) AS LINHA,
	cQuery += "CTT.CTT_FILIAL, CTT.CTT_CUSTO, CTT.CTT_DESC01
	cQuery += " FROM " + RetSqlName("CTT") + " CTT "
	cQuery += " WHERE " + If(!Empty(cSearch), "(CTT.CTT_FILIAL LIKE ? OR CTT.CTT_CUSTO LIKE ? OR CTT.CTT_DESC01 LIKE ?) AND ", "") 
	cQuery += " CTT.D_E_L_E_T_ = '' AND CTT.CTT_CLASSE = '2' AND CTT.CTT_BLOQ = '2' " + If(!Empty(aFilPar),If(nTam > 0 , "AND CTT.CTT_FILIAL IN (?)", "AND CTT.CTT_FILIAL = ''"),"")
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	__cEmpAntCC  := cEmpAnt
	cQuery       := ChangeQuery(cQuery) 
	oStatementCC := FwExecStatement():New(cQuery)
EndIf
If !Empty(cSearch)
	oStatementCC:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementCC:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementCC:SetString(nPOrder++, "%"+cSearch+"%")
EndIf
If nTam > 0 .and. !Empty(aFilPar)
	oStatementCC:SetIn(nPOrder++, aFilPar)
EndIf	
oStatementCC:SetString(nPOrder++, cValToChar(nStart))
oStatementCC:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStatementCC:OpenAlias()
dbSelectArea(cAlias)

While !(cAlias)->(Eof())

	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf 
	
	oItem := JSonObject():new()
	oItem["filCC"]  := EncodeUTF8((cAlias)->CTT_FILIAL)
	oItem["codCC"]  := EncodeUTF8((cAlias)->CTT_CUSTO)
	oItem["ccDesc"] := EncodeUTF8(Rtrim((cAlias)->CTT_DESC01))

	aadd(oResponse["items"], oItem)
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext 
	
oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getDeptoRhGestao
Serviço para retornar lista de departamentos para consulta padrao
@author	Leandro Drumond
@since	17/10/2025
*/
method getDeptoRhGestao() class GPEGestao
local oItem	as Object
local jParams := oRest:getQueryRequest() as Json
local oResponse := JsonObject():New() as Json
local cSearch as character
local cAlias as character		
local cQuery as character 
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nTam as numeric
local nI as numeric
local lHasNext as logical
local aFilPar as array

Static __cEmpAntDE := cEmpAnt
Static oStatementDE

cSearch   := IIf(jParams:hasProperty("filter"), jParams["filter"], "")
aFilPar   := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams["branchCode"], ","), {})
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])
nPOrder   := 1

If Empty(aFilPar)
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid := self:getFilVld(StrTokArr(__cValidFil, "/"))
	aFilPar := aClone(aFilValid)
EndIf

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := (nPage - 1) * nPageSize + 1
nEnd   :=  nPage * nPageSize + 1

oResponse["items"] := {}

If Len(Rtrim(xFilial("SQB"))) > 0
	nTam := Len(Rtrim(xFilial("SQB")))
	For nI := 1 To Len(aFilPar)
      	aFilPar[nI] := SubStr(aFilPar[nI], 1, nTam)
	Next nI
EndIf

If oStatementDE == Nil .Or. __cEmpAntDE <> cEmpAnt .Or. nStart == 1
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY SQB.QB_FILIAL, SQB.QB_DEPTO ASC) AS LINHA,
	cQuery += " SQB.QB_FILIAL, SQB.QB_DEPTO, SQB.QB_DESCRIC
	cQuery += " FROM "+RetSqlName("SQB")+" SQB "
	cQuery += " WHERE " + If(!Empty(cSearch), "(SQB.QB_FILIAL LIKE ? OR SQB.QB_DEPTO LIKE ? OR SQB.QB_DESCRIC LIKE ?) AND ", "") 
	cQuery += "SQB.D_E_L_E_T_ = '' " + If(!Empty(aFilPar),If(nTam > 0 , "AND SQB.QB_FILIAL IN (?)", "AND SQB.QB_FILIAL = ''"),"")
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	__cEmpAntDE  := cEmpAnt
	cQuery       := ChangeQuery(cQuery) 
	oStatementDE := FwExecStatement():New(cQuery)
EndIf
If !Empty(cSearch)
	oStatementDE:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementDE:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementDE:SetString(nPOrder++, "%"+cSearch+"%")
EndIf
If nTam > 0 .and. !Empty(aFilPar)
	oStatementDE:SetIn(nPOrder++, aFilPar)
EndIf	
oStatementDE:SetString(nPOrder++, cValToChar(nStart))
oStatementDE:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStatementDE:OpenAlias()
dbSelectArea(cAlias)

While !(cAlias)->(Eof())

	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf 

	oItem := JSonObject():new()
	oItem["filDepto"]  := EncodeUTF8((cAlias)->QB_FILIAL)
	oItem["codDepto"]  := EncodeUTF8((cAlias)->QB_DEPTO)
	oItem["deptoDesc"] := EncodeUTF8(Rtrim((cAlias)->QB_DESCRIC))

	aadd(oResponse["items"], oItem)
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext 	

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getFuncaoRhGestao
Serviço para retornar lista de funções para consulta padrao
@author	Leandro Drumond
@since	17/10/2025
*/
method getFuncaoRhGestao() class GPEGestao
local oItem	as Object
local jParams := oRest:getQueryRequest() as Json
local oResponse := JsonObject():New() as Json
local cSearch as character
local cAlias as character		
local cQuery as character 
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nTam as numeric
local nI as numeric
local lHasNext as logical
local aFilPar as array

Static __cEmpAntFF := cEmpAnt
Static oStatementFF

cSearch   := IIf(jParams:hasProperty("filter"), jParams["filter"], "")
aFilPar   := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams["branchCode"], ","), {})
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])
nPOrder   := 1

If Empty(aFilPar)
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid := self:getFilVld(StrTokArr(__cValidFil, "/"))
	aFilPar := aClone(aFilValid)
EndIf

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := (nPage - 1) * nPageSize + 1
nEnd   :=  nPage * nPageSize + 1

oResponse["items"] := {}

If Len(Rtrim(xFilial("SRJ"))) > 0
	nTam := Len(Rtrim(xFilial("SRJ")))
	For nI := 1 To Len(aFilPar)
      	aFilPar[nI] := SubStr(aFilPar[nI], 1, nTam)
	Next nI
EndIf

If oStatementFF == Nil .Or. __cEmpAntFF <> cEmpAnt .Or. nStart == 1
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY SRJ.RJ_FILIAL, SRJ.RJ_FUNCAO ASC) AS LINHA,
	cQuery += " SRJ.RJ_FILIAL, SRJ.RJ_FUNCAO, SRJ.RJ_DESC
	cQuery += " FROM "+RetSqlName("SRJ")+" SRJ "
	cQuery += " WHERE " + If(!Empty(cSearch), "(SRJ.RJ_FILIAL LIKE ? OR SRJ.RJ_FUNCAO LIKE ? OR SRJ.RJ_DESC LIKE ?) AND ", "") 
	cQuery += "SRJ.D_E_L_E_T_ = '' " + If(!Empty(aFilPar),If(nTam > 0, "AND SRJ.RJ_FILIAL IN (?)", "AND SRJ.RJ_FILIAL = ''"),"")
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	__cEmpAntFF  := cEmpAnt
	cQuery       := ChangeQuery(cQuery) 
	oStatementFF := FwExecStatement():New(cQuery)
EndIf
If !Empty(cSearch)
	oStatementFF:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementFF:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementFF:SetString(nPOrder++, "%"+cSearch+"%")
EndIf
If nTam > 0 .and. !Empty(aFilPar)
	oStatementFF:SetIn(nPOrder++, aFilPar)
EndIf
oStatementFF:SetString(nPOrder++, cValToChar(nStart))
oStatementFF:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStatementFF:OpenAlias()
dbSelectArea(cAlias)

While !(cAlias)->(Eof()) 

	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf 
	
	oItem := JSonObject():new()
	oItem["filFuncao"]  := EncodeUTF8((cAlias)->RJ_FILIAL)
	oItem["codFuncao"]  := EncodeUTF8((cAlias)->RJ_FUNCAO)
	oItem["funcaoDesc"] := EncodeUTF8(Rtrim((cAlias)->RJ_DESC))

	aadd(oResponse["items"], oItem)
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext 	

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getOpcoesRhGestao
Serviço para retornar lista de categorias e situações para consulta padrao
@author	Leandro Drumond
@since	17/10/2025
*/
method getOpcoesRhGestao() class GPEGestao
local oItem	as Object
local oResponse := JsonObject():New() as Json
local aCategoria := {} as array
local aSituacao  := {} as array
local nI as numeric

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

dbSelectArea("SX5")
	
If dbSeek(cFilial+"28")
	While !Eof() .AND. SX5->X5_Tabela == "28"
		If Left(SX5->X5_Chave, 1) >= 'A'
			Aadd(aCategoria, {Left(SX5->X5_Chave, 1), Alltrim(X5Descri())})
		EndIf
		dbSkip()
	Enddo
EndIf	

If dbSeek(cFilial+"31")
	While !Eof() .AND. SX5->X5_Tabela == "31"
		Aadd(aSituacao, {Left(SX5->X5_Chave, 1), Alltrim(X5Descri())})
		dbSkip()
	Enddo
EndIf

SX5->(dbCloseArea())
 
oResponse["items"] := JsonObject():New()
oResponse["items"]["sitOptions"] := {}
oResponse["items"]["catOptions"] := {}

For nI := 1 To Len(aSituacao)
	oItem := JsonObject():new()
    oItem["value"] := If(Empty(aSituacao[nI][1]), "N", aSituacao[nI][1])
	oItem["label"] := aSituacao[nI][2]
	aAdd(oResponse["items"]["sitOptions"], oItem)
Next nI

For nI := 1 To Len(aCategoria)
	oItem := JsonObject():new()
    oItem["value"] := aCategoria[nI][1]
	oItem["label"] := aCategoria[nI][2]
	aAdd(oResponse["items"]["catOptions"], oItem)
Next nI

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getVerbaRhGestao
Serviço para retornar lista de verbas para consulta padrao
@author	Leandro Drumond
@since	28/10/2025
*/
method getVerbaRhGestao() class GPEGestao
local oItem	as Object
local jParams := oRest:getQueryRequest() as Json
local oResponse := JsonObject():New() as Json
local cSearch as character
local cAlias as character		
local cQuery as character 
local cCodPd as character
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nTam as numeric
local nI as numeric
local lHasNext as logical
local aFilPar as array

Static __cEmpAntPD := cEmpAnt
Static oStatementPD

cSearch   := IIf(jParams:hasProperty("load"), jParams["load"], "")
aFilPar   := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams["branchCode"], ","), {})
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])
nPOrder   := 1

If Empty(aFilPar)
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid := self:getFilVld(StrTokArr(__cValidFil, "/"))
	aFilPar := aClone(aFilValid)
EndIf

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := (nPage - 1) * nPageSize + 1
nEnd   :=  nPage * nPageSize + 1

oResponse["items"] := {}

If Len(Rtrim(xFilial("SRV"))) > 0
	nTam := Len(Rtrim(xFilial("SRV")))
	For nI := 1 To Len(aFilPar)
      	aFilPar[nI] := SubStr(aFilPar[nI], 1, nTam)
	Next nI
EndIf

If oStatementPD == Nil .Or. __cEmpAntPD <> cEmpAnt .Or. nStart == 1
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY SRV.RV_FILIAL, SRV.RV_COD ASC) AS LINHA,
	cQuery += " SRV.RV_FILIAL, SRV.RV_COD, SRV.RV_DESC
	cQuery += " FROM "+RetSqlName("SRV")+" SRV "
	cQuery += " WHERE " + If(!Empty(cSearch), "(SRV.RV_FILIAL LIKE ? OR SRV.RV_COD LIKE ? OR SRV.RV_DESC LIKE ?) AND ", "") 
	cQuery += "SRV.D_E_L_E_T_ = '' " + If(!Empty(aFilPar),If(nTam > 0, "AND SRV.RV_FILIAL IN (?)", "AND SRV.RV_FILIAL = ''"),"")
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	__cEmpAntPD  := cEmpAnt
	cQuery       := ChangeQuery(cQuery) 
	oStatementPD := FwExecStatement():New(cQuery)
EndIf
If !Empty(cSearch)
	oStatementPD:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementPD:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementPD:SetString(nPOrder++, "%"+cSearch+"%")
EndIf
If nTam > 0 .and. !Empty(aFilPar)
	oStatementPD:SetIn(nPOrder++, aFilPar)
EndIf

oStatementPD:SetString(nPOrder++, cValToChar(nStart))
oStatementPD:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStatementPD:OpenAlias()
dbSelectArea(cAlias)

cCodPd := ""

While !(cAlias)->(Eof()) 

	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf 
	
	If !((cAlias)->RV_COD $ cCodPd) //Inclui código único (devido a existencia de várias verbas com o memso código em cada filial)
		oItem := JSonObject():new()
		oItem["filVerba"]  := EncodeUTF8((cAlias)->RV_FILIAL)
		oItem["codVerba"]  := EncodeUTF8((cAlias)->RV_COD)
		oItem["verbaDesc"] := EncodeUTF8(Rtrim((cAlias)->RV_DESC))

		aadd(oResponse["items"], oItem)

		cCodPd += (cAlias)->RV_COD + "/"
	EndIf
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext 	

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getConfigRhGestao
Serviço para retornar as configurações auxiliares da rotina
@author	Leandro Drumond
@since	04/11/2025
*/
method getConfigRhGestao() class GPEGestao
local oItem	     := JsonObject():new() as object
local oProfile   := FwProfile():New() as object
local oResponse  := JsonObject():New() as Json
local lVldFecFol := GetMvRH( "MV_FECFOL" , .F., .F. ) as logical
local aParams    := {} as array 
local lSchedIsOn := totvs.framework.smartschedule.startSchedule.smartSchedIsRunning() .And. totvs.framework.eventviewer.checkNewEventViewer() //Apenas permite a execução em segundo plano se o se sistema estiver apto para tal
local lCfgSV     := fConfigSV()

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

oResponse["items"] := {}
oProfile:SetUser(RetCodUsr())
oProfile:SetProgram("rh.sv.sigagpe.gestao")
oProfile:SetTask("RHGESTAO")

aParams := oProfile:Load()

If Len(aParams) >= 1 
	oItem["calcSegPlan"]     := lSchedIsOn .and. aParams[1]
Else 
	oItem["calcSegPlan"]     := .F.
EndIf

oItem["validFol"]     	:= lVldFecFol
oItem["disableSegPlan"] := !lSchedIsOn
oItem["smartView"]		:= lCfgSV
oProfile:DeActivate()

aAdd(oResponse["items"], oItem)

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getStatusRhGestao
Serviço para retornar as configurações auxiliares da rotina
@author	Leandro Drumond
@since	06/11/2025
*/
method getStatusRhGestao() class GPEGestao
local oResponse  := JsonObject():New() as Json
local aLog 		 := {} as array
local aListTask  := {} as array
local nTaskEnd   := 0 as numeric
local nX 		 := 0 as numeric

aListTask   := Gpm946LoadPolling()

aEval(aListTask, {|x| If(!x[2], nTaskEnd++, Nil)})

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

oResponse['status']  := 'IN_PROGRESS'

If Len(aListTask) == 0 .or. nTaskEnd == Len(aListTask)
	oResponse['status']  := 'FINALIZADO'
	For nX := 1 to Len(aListTask)
		If !Empty(aListTask[nX,3])
			aLog := self:getLogProc(aListTask[nX,3], , aLog)
		EndIf 
	Next nX
EndIf

oResponse['message'] := STR0001 //'Execução em segundo plano finalizada'
oResponse['log'] 	 := aLog

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Post postConfigRhGestao
API para gravação das configurações auxiliares da rotina
@author	Leandro Drumond
@since	04/11/2025
*/
method postConfigRhGestao() class GPEGestao
local oJsResp as object
local oProfile := FwProfile():New() as object
local oJsBody  := JsonObject():new() as Json
local aParams as array
local lGrv as logical

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

//Recupera o conteudo do body
oJsBody:fromJson( oRest:GetBodyRequest() )

If Valtype(oJsBody["items"]) != "U" .And. Len(oJsBody["items"]) > 0   
	aParams := {oJsBody["items"][1]["calcSegPlan"]}
	lGrv    := .T.
	oProfile:SetUser(RetCodUsr())
	oProfile:SetProgram("rh.sv.sigagpe.gestao")
	oProfile:SetTask("RHGESTAO")
    oProfile:SetProfile(aParams)
    oProfile:Save()
    oProfile:DeActivate()
EndIf

oJsResp := JSonObject():new()
oJsResp['code']    := If(lGrv, CodeRespCreated, CodeRespBadRequest)
oJsResp['message'] := If(lGrv, STR0002, STR0003) //"Configurações gravadas com sucesso."###"Erro ao gravar as configurações."
oRest:setStatusCode(If(lGrv, CodeRespCreated, CodeRespBadRequest))
oRest:setResponse(EncodeUTF8(FwCutOff(oJsResp:toJson())))

Return

/*
{Protheus.doc} Post postCalcRhGestao
API de solicitação de processamento de cálculo no Protheus
@author	Leandro Drumond
@since	17/10/2025
*/
method postCalcRhGestao() class GPEGestao
local oJsResp   	:= JSonObject():new() as json
local oJsBody   	:= JsonObject():new() as json
local oFiltros  	as json
local oTask 		as object
local aCalcula  	:= {} as array
local aLog      	:= {} as array
local aRoteiros 	:= {} as array 
local aParamSx1 	:= {} as array
local aNotCalc  	:= {} as array
local xRet 			:= {} as array
local cFilCalc  	:= "" as character
local cPergunte 	:= "" as character
local cValAux  	 	:= "" as character
local cKeyAux  	 	:= "" as character
local lRet      	:= .T. as logical
local lLog 			:= .F. as logical
local lCalcSegPlan	:= .F. as logical
local nX 			:= 0 as numeric
local nY 			:= 0 as numeric

oJsBody:fromJson( oRest:GetBodyRequest() )

aRoteiros 	 := oJsBody["roteiros"] // Array de roteiros para calcular
aParamSx1 	 := oJsBody["sx1"]      // Array de grupos de perguntas
oFiltros  	 := oJsBody["filtros"]  // Objeto filtros de usuário
lCalcSegPlan := oJsBody["calcsegplan"] // Calcula em segundo plano

If Len(aParamSx1) > 0
	For nX:= 1 to Len(aParamSx1)
		cPergunte := aParamSx1[nX]["grupo"]
		Pergunte(cPergunte,.F.)
		For nY := 1 to Len(aParamSx1[nX]["items"])
			lExistProp := aParamSx1[nX]["items"][nY]:hasProperty("valor")
			If lExistProp .and. ValType(&(Upper(aParamSx1[nX]["items"][nY]["variavel"]))) == "D"
				SetMVValue(cPergunte,Upper(aParamSx1[nX]["items"][nY]["variavel"]),CtoD(aParamSx1[nX]["items"][nY]["valor"]),.T.)
			ElseIf lExistProp .and. ValType(aParamSx1[nX]["items"][nY]["valor"]) == "A"
				cValAux := ''
				aEval(aParamSx1[nX]["items"][nY]["valor"], {|x| cValAux += x})
				SetMVValue(cPergunte,Upper(aParamSx1[nX]["items"][nY]["variavel"]),cValAux,.T.)
			Else 
				SetMVValue(cPergunte,Upper(aParamSx1[nX]["items"][nY]["variavel"]),If(lExistProp, aParamSx1[nX]["items"][nY]["valor"], ''),.T.)
			EndIf
		Next nY
		Pergunte(cPergunte,.F.)
	Next nX		
EndIf
If ValType(oFiltros["branchCode"]) == "C" 
	If !Empty(oFiltros["branchCode"])
		cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_FILIAL $ "'
		cFilCalc += oFiltros["branchCode"] + '*/"'
	EndIf
ElseIf ValType(oFiltros["branchCode"]) == "A" .and. Len(oFiltros["branchCode"]) > 0
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_FILIAL $ "'
	For nX:= 1 to Len(oFiltros["branchCode"])
		cFilCalc += oFiltros["branchCode"][nX] + "*/"
	Next nX
	cFilCalc += '"'
EndIf
If !Empty(oFiltros["matCode"])
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_MAT >= "' + oFiltros["matCode"] + '"'
EndIf 
If !Empty(oFiltros["matCodeAte"])
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_MAT <= "' + oFiltros["matCodeAte"] + '"'
EndIf 
If ValType(oFiltros["codCC"]) == "A" .and. Len(oFiltros["codCC"]) > 0
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_CC $ "'
	For nX:= 1 to Len(oFiltros["codCC"])
		cFilCalc += oFiltros["codCC"][nX] + "*/"
	Next nX
	cFilCalc += '"'
EndIf 
If ValType(oFiltros["codFuncao"]) == "A" .and. Len(oFiltros["codFuncao"]) > 0
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_CODFUNC $ "'
	For nX:= 1 to Len(oFiltros["codFuncao"])
		cFilCalc += oFiltros["codFuncao"][nX] + "*/"
	Next nX
	cFilCalc += '"'
EndIf 
If ValType(oFiltros["codDepto"]) == "A" .and. Len(oFiltros["codDepto"]) > 0
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_DEPTO $ "'
	For nX:= 1 to Len(oFiltros["codDepto"])
		cFilCalc += oFiltros["codDepto"][nX] + "*/"
	Next nX
	cFilCalc += '"'
EndIf 
If ValType(oFiltros["situacao"]) == "A" .and. Len(oFiltros["situacao"]) > 0
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_SITFOLH $ "'
	For nX:= 1 to Len(oFiltros["situacao"])
		cFilCalc += If(oFiltros["situacao"][nX] == "N", " ", oFiltros["situacao"][nX]) + "*/"
	Next nX
	cFilCalc += '"'
EndIf 
If ValType(oFiltros["categoria"]) == "A" .and. Len(oFiltros["categoria"]) > 0
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_CATFUNC $ "'
	For nX:= 1 to Len(oFiltros["categoria"])
		cFilCalc += oFiltros["categoria"][nX] + "*/"
	Next nX
	cFilCalc += '"'
EndIf 
If !Empty(oFiltros["dataAdmissaoAte"]) 
	cFilCalc += If(Empty(cFilCalc), "", " .AND. ") + 'SRA->RA_ADMISSA <= "' + DtoS(SToD(StrTran(SubStr(oFiltros["dataAdmissaoAte"], 1, 10), "-" ))) + '"'
EndIf

If lCalcSegPlan 
	cKeyAux := "RHGESTAO" + __cUserId + cValToChar(TimeFull())
EndIf

For nX := 1 To Len(aRoteiros)
	//Se não conseguir lockar, esta sendo processado em outra thread
	If Gpm946Lock(cKeyAux, "RHGESTAO" + aRoteiros[nX]["filial"] + aRoteiros[nX]["processo"] + aRoteiros[nX]["roteiro"] + aRoteiros[nX]["periodo"] + aRoteiros[nX]["semana"])
		aAdd( aCalcula, { 	aRoteiros[nX]["processo"],;
							aRoteiros[nX]["roteiro"],; 
							aRoteiros[nX]["periodo"],; 
							aRoteiros[nX]["semana"],; 
							aRoteiros[nX]["tipo"],; 
							aRoteiros[nX]["filial"],;
							lCalcSegPlan,;
							cFilCalc,;
							cKeyAux} )
	Else
		aAdd( aNotCalc, { 	aRoteiros[nX]["filial"],;
							aRoteiros[nX]["processo"],;
							aRoteiros[nX]["roteiro"],; 
							aRoteiros[nX]["periodo"],; 
							aRoteiros[nX]["semana"]} )
	EndIf
Next nX

oJsResp['polling'] := .F.

If Len(aCalcula) > 0
	If !lCalcSegPlan
		xRet := GPEM020A(.T., aCalcula, .T., cFilCalc )
		xRet := If((Valtype(xRet) == "A" .and. Len(xRet) > 0), xRet, {})

		lRet := Len(xRet) > 0

		lLog := lRet .and.  Len(xRet) > 1 .and. Len(xRet[2]) > 0 .and. aScan(xRet[2], {|x| !Empty(x) }) > 0

		oJsResp['message'] := if(lRet, STR0010 + If( lLog .or. Len(aNotCalc) > 0, STR0009, ""),STR0012) //"Processamento finalizado. " # "Consulte o log para detalhes." # "Erro não identificado. Consulte o console do Protheus."

		For nX := 1 To Len(aCalcula)
			//Desfaz semáforo
			Gpm946UnLock(cKeyAux, "RHGESTAO" + aCalcula[nX][6] + aCalcula[nX][1] + aCalcula[nX][2] + aCalcula[nX][3] + aCalcula[nX][4])
		Next nX
	Else 
		oTask := totvs.framework.schedule.utils.createTask(GetEnvServer(), cEmpAnt, cFilAnt, "GPEM020A", 7, RetCodUsr(), NIL, { aCalcula })

		lRet := (oTask != NIL .and. !Empty(oTask:cID))
		
		oJsResp['message'] := if(lRet, STR0006,STR0007) //"Tarefa a ser executada em segundo plano adicionada à fila de processamento." ### "Falha na execução da tarefa em segundo plano."
		
		If lRet 
			oJsResp['polling'] := .T.
			Gpm946LoadPolling(cKeyAux)
		EndIf

	EndIf 
Else 
	oJsResp['message'] := STR0008 + If(Len(aNotCalc) > 0, STR0009, "") //"Nenhum roteiro processado. " ### "Consulte o log para detalhes."
EndIf

If Len(aNotCalc) > 0 .or. Len(xRet) > 0
	aLog := self:getLogProc(xRet, aNotCalc)
EndIf

oJsResp['code']    := If(lRet, CodeRespCreated, CodeRespBadRequest)
oJsResp['log']     := aLog
oRest:setStatusCode(oJsResp['code'])
oRest:setResponse(oJsResp:toJson())

return

/*
{Protheus.doc} Post postIntegraRhGestao
API de solicitação de processamento da integração no Protheus
@author	Leandro Drumond
@since	27/10/2025
*/
method postIntegraRhGestao() class GPEGestao
local oJsResp   	:= JSonObject():new() as json
local oJsBody   	:= JsonObject():new() as json
local aIntegra  	:= {} as array
local aLog      	:= {} as array
local aRoteiros 	:= {} as array 
local aNotCalc  	:= {} as array
local xRet 			:= {} as array
local cKeyAux		:= "" as character
local lRet      	:= .T. as logical
Local lCancela  	:= .F. as logical
local lCalcSegPlan 	:= .F. as logical
local nX as numeric

oJsBody:fromJson( oRest:GetBodyRequest() )

aRoteiros := oJsBody["roteiros"] // Array de roteiros para calcular
lCancela  := oJsBody["cancela"]
lCalcSegPlan := oJsBody["calcsegplan"] // Calcula em segundo plano

If lCalcSegPlan 
	cKeyAux := "RHGESTAO" + __cUserId + cValToChar(TimeFull())
EndIf

For nX := 1 To Len(aRoteiros)
	If  Gpm946Lock(cKeyAux, "RHGESTAO" + aRoteiros[nX]["filial"] + aRoteiros[nX]["processo"] + aRoteiros[nX]["roteiro"] + aRoteiros[nX]["periodo"] + aRoteiros[nX]["semana"])
		aAdd( aIntegra, {   aRoteiros[nX]["processo"],;
							aRoteiros[nX]["roteiro"],; 
							aRoteiros[nX]["periodo"],; 
							aRoteiros[nX]["semana"],; 
							aRoteiros[nX]["tipo"],; 
							dDataBase,;
							aRoteiros[nX]["filial"],;
							lCalcSegPlan,;
							lCancela,;
							cKeyAux} )
	Else
		aAdd( aNotCalc, { 	aRoteiros[nX]["filial"],;
							aRoteiros[nX]["processo"],;
							aRoteiros[nX]["roteiro"],; 
							aRoteiros[nX]["periodo"],; 
							aRoteiros[nX]["semana"]} )
	EndIf
Next nX

oJsResp['polling'] := .F.

If Len(aIntegra) > 0
	If !lCalcSegPlan
		xRet := GPEM019(lCancela, aIntegra, , , .T. )

		xRet := If(Valtype(xRet) == "A" .and. ( xRet[1] .or. Len(xRet[2]) > 0 ), xRet , {})	

		lRet := (Len(xRet) > 1 .and. ( xRet[1] .or. Len(xRet[2]) > 0 ) )		

		oJsResp['message'] := if(lRet, STR0010 + If(( Len(xRet) > 1 .and. Len(xRet[2]) > 0 )  .or. Len(aNotCalc) > 0, STR0009, ""),STR0012) //"Processamento finalizado. " # "Consulte o log para detalhes." # "Erro não identificado. Consulte o console do Protheus."
		
		For nX := 1 To Len(aIntegra)
			//Desfaz semáforo - Se for execução em segundo plano, ele será feito e desfeito dentro da rotina novamente
			Gpm946UnLock(cKeyAux, "RHGESTAO" + aIntegra[nX][7] + aIntegra[nX][1] + aIntegra[nX][2] + aIntegra[nX][3] + aIntegra[nX][4])
		Next nX
	Else 
		oTask := totvs.framework.schedule.utils.createTask(GetEnvServer(), cEmpAnt, cFilAnt, "GPEM019", 7, RetCodUsr(), NIL, { aIntegra })

		lRet := (oTask != NIL .and. !Empty(oTask:cID))

		oJsResp['message'] := if(lRet, STR0006,STR0007) //"Tarefa a ser executada em segundo plano adicionada à fila de processamento." ##  "Falha na execução da tarefa em segundo plano."

		If lRet 
			oJsResp['polling'] := .T.
			Gpm946LoadPolling(cKeyAux)
		EndIf
	EndIf
Else 
	oJsResp['message'] := STR0008 + If(Len(aNotCalc) > 0, STR0009, "") //"Nenhum roteiro processado. " ### "Consulte o log para detalhes."
EndIf

If lRet .and. Len(xRet) > 2
	xRet := {xRet[2], xRet[3]}
Else 
	xRet := {}
EndIf
 
If lRet .or. Len(aNotCalc) > 0
	aLog := self:getLogProc(xRet, aNotCalc)
EndIf

oJsResp['code']    := If(lRet, CodeRespCreated, CodeRespBadRequest)
oJsResp['log']     := aLog
oRest:setStatusCode(oJsResp['code'])
oRest:setResponse(oJsResp:toJson())

return

/*
{Protheus.doc} Post postFechamentoRhGestao
API de solicitação de processamento do fechamento de período no Protheus
@author	Leandro Drumond
@since	30/10/2025
*/
method postFechamentoRhGestao() class GPEGestao
local oJsResp   	:= JSonObject():new() as json
local oJsBody   	:= JsonObject():new() as json
local oTask           as Object
local aLog      	:= {} as array
local aRoteiros 	:= {} as array 
local aProcessos	:= {} as array
local aNotCalc  	:= {} as array
local xRet 			:= {} as array
local cKeyAux		:= "" as character
local lRet      	:= .T. as logical
local lCalcSegPlan	:= .F. as logical
local nX as numeric

oJsBody:fromJson( oRest:GetBodyRequest() )

aRoteiros := oJsBody["roteiros"] // Array de roteiros para calcular
lCalcSegPlan := oJsBody["calcsegplan"] // Calcula em segundo plano

If lCalcSegPlan 
	cKeyAux := "RHGESTAO" + __cUserId + cValToChar(TimeFull())
EndIf

For nX := 1 To Len(aRoteiros) 
	If Gpm946Lock(cKeyAux, "RHGESTAO" + aRoteiros[nX]["filial"] + aRoteiros[nX]["processo"] + aRoteiros[nX]["roteiro"] + aRoteiros[nX]["periodo"] + aRoteiros[nX]["semana"])
		aAdd( aProcessos, { aRoteiros[nX]["roteiro"],; 
							aRoteiros[nX]["periodo"],; 
							aRoteiros[nX]["semana"],; 
							aRoteiros[nX]["tipo"],; 
							aRoteiros[nX]["filial"],;
							aRoteiros[nX]["processo"],;
							lCalcSegPlan,; //Indica que foi chamado para execução em segundo plano via API
							cKeyAux}) 
	Else 
		aAdd( aNotCalc, { 	aRoteiros[nX]["filial"],;
							aRoteiros[nX]["processo"],;
							aRoteiros[nX]["roteiro"],; 
							aRoteiros[nX]["periodo"],; 
							aRoteiros[nX]["semana"]} )
	EndIf
Next nX

oJsResp['polling'] := .F.

If Len(aProcessos) > 0
	If !lCalcSegPlan
		xRet := GPEM120( , , , aProcessos)

		lRet := (Valtype(xRet) == "A" .and. Len(xRet[1]) > 0)

		xRet := If(lRet, xRet , {})	

		lLog := lRet .and.  Len(xRet) > 1 .and. Len(xRet[2]) > 0 .and. aScan(xRet[2], {|x| !Empty(x) }) > 0 

		oJsResp['message'] := if(lRet, STR0010 + If(lLog .or. Len(aNotCalc) > 0, STR0009, ""),STR0012) //"Processamento finalizado. " # "Consulte o log para detalhes." # "Erro não identificado. Consulte o console do Protheus."

		For nX := 1 To Len(aProcessos)
			//Desfaz semáforo
			Gpm946UnLock(cKeyAux, "RHGESTAO" + aProcessos[nX][5] + aProcessos[nX][6] + aProcessos[nX][1] + aProcessos[nX][2] + aProcessos[nX][3])
		Next nX
	Else
		oTask := totvs.framework.schedule.utils.createTask(GetEnvServer(), cEmpAnt, cFilAnt, "GPEM120", 7, RetCodUsr(), NIL, { aProcessos })

		lRet := (oTask != NIL .and. !Empty(oTask:cID))

		oJsResp['message'] := if(lRet, STR0006,STR0007) //"Tarefa a ser executada em segundo plano adicionada à fila de processamento." ## "Falha na execução da tarefa em segundo plano."

		If lRet 
			oJsResp['polling'] := .T.
			Gpm946LoadPolling(cKeyAux)
		EndIf
	EndIf
Else	
	oJsResp['message'] := STR0008 + If(Len(aNotCalc) > 0, STR0009, "") //"Nenhum roteiro processado. " ### "Consulte o log para detalhes."
EndIf

If Len(aNotCalc) > 0 .Or. (Valtype(xRet) == "A" .and. Len(xRet) > 0)
	aLog := self:getLogProc(xRet, aNotCalc)
EndIf

oJsResp['code']    := If(lRet, CodeRespCreated, CodeRespBadRequest)
oJsResp['log']     := aLog
oRest:setStatusCode(oJsResp['code'])
oRest:setResponse(oJsResp:toJson())

return

/*{Protheus.doc} getStatus
Retorna status do roteiro
@author	Leandro Drumond
@since	17/10/2025
*/
method getStatus(cAlias as character) as character class GPEGestao
local cRet as character

If (cAlias)->RY_INTEGRA == "1" 
	cRet := If(!Empty((cAlias)->RCH_DTINTE), "2", "3")
Else
	cRet := If ((cAlias)->(CONTADOR) > 0, "1", "4" )
EndIf

Return cRet

/*{Protheus.doc} getFilVld
Retorna array de filiais que usuário possui acesso
@author	Leandro Drumond
@since	17/10/2025
*/
method getFilVld(aVldFil as array) as array class GPEGestao
local aFiliais := {} as array
local nX as numeric

For nX := 1 to Len(aVldFil)
	If !Empty(aVldFil[nX])
		aAdd(aFiliais, aVldFil[nX])
	EndIf
Next nX

Return aFiliais

/*{Protheus.doc} getLogProc
Monta log amigável para exibição na tela
@author	Leandro Drumond
@since	17/10/2025
*/
method getLogProc(aLog as array, aNotCalc as array, aRet as array) as array class GPEGestao
local aLogAux   := {} as array
local nX 		:= 0  as numeric
local oitem 	      as object

DEFAULT aLog 	 := {} 
DEFAULT aNotCalc := {}
DEFAULT aRet 	 := {}

If Len(aLog) > 1
	For nX := 1 to Len(aLog[1])
		If !Empty(aLog[2][nX])
			oItem := JSonObject():new()
			
			oItem["titulo"]    := aLog[1][nX]
			oItem["detalhe"]   := aLog[2][nX]
			
			aAdd(aRet, oItem)
		EndIf
	Next nX
EndIf

If Len(aNotCalc) > 0
	For nX := 1 to Len(aNotCalc)
		If Len(aLogAux) == 0
			aAdd( aLogAux,  Padr("Filial",Max(10,Len(aNotCalc[nX][1]) + 2)) + ;
							Padr("Processo",10) + ;
							Padr("Roteiro", 10) + ; 
							Padr("Periodo",10) + ; 
							Padr("Semana",10) )
		EndIf
		aAdd( aLogAux,  	Padr(aNotCalc[nX][1],Max(10,Len(aNotCalc[nX][1]) + 2)) + ;
							Padr(aNotCalc[nX][2],10) + ;
							Padr(aNotCalc[nX][3],10) + ; 
							Padr(aNotCalc[nX][4],10) + ; 
							Padr(aNotCalc[nX][5],10) )
	Next nX
	
	oItem := JSonObject():new()
	oItem["titulo"]    := STR0011 //"Os seguintes roteiros estão em processamento em outra thread"
	oItem["detalhe"]   := aLogAux

	aAdd(aRet, oItem)
EndIf

return aRet

/*-------------------------------------------------------------------
{Protheus.doc} Get getProcessoRhGestao
Serviço para retornar uma lista de processos de cálculo

@author	Bruno Costa
@since	19/05/2026
-------------------------------------------------------------------*/
method getProcessoRhGestao() class GPEGestao
local oItem	as object
local jParams := oRest:getQueryRequest() as json
local oResponse := JsonObject():New() as json
local cSearch as character
local cAlias as character		
local cQuery as character 
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nTam as numeric
local nI as numeric
local lHasNext as logical
local lTemFil as logical
local aFilPar as array

Static oStatementProc

cSearch   := Upper(IIf(jParams:hasProperty("filter"), jParams["filter"], ""))
aFilPar   := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams["branchCode"], ","), {})
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])
nPOrder   := 1

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := If(!Empty(cSearch), 1, (nPage - 1) * nPageSize + 1)
nEnd   := nPage * nPageSize + 1

oResponse["items"] := {}

If (nTam := Len(Rtrim(xFilial("RCJ")))) > 0 
	For nI := 1 To Len(aFilPar)
      aFilPar[nI] := SubStr(aFilPar[nI], 1, nTam)
	  lTemFil := .T.
	Next nI
EndIf

If oStatementProc == Nil .Or. nStart == 1 .Or. !Empty(cSearch)
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RCJ.RCJ_FILIAL, RCJ.RCJ_CODIGO ASC) AS LINHA, "
	cQuery += " RCJ.RCJ_FILIAL, RCJ.RCJ_CODIGO, RCJ_DESCRI "
	cQuery += " FROM "+RetSqlName("RCJ")+" RCJ "
	cQuery += " WHERE RCJ.D_E_L_E_T_ = ? " + If(lTemFil, "AND RCJ.RCJ_FILIAL IN (?)", "")
	If !Empty(cSearch) 
		cQuery += " AND (UPPER(RCJ.RCJ_CODIGO) LIKE ? OR UPPER(RCJ.RCJ_DESCRI) LIKE ?) "
	EndIf
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	cQuery         := ChangeQuery(cQuery) 
	oStatementProc := FwExecStatement():New(cQuery)
EndIf

oStatementProc:SetString(nPOrder++, " ")

If lTemFil
	oStatementProc:SetIn(nPOrder++, aFilPar)
EndIf
If !Empty(cSearch)
	oStatementProc:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementProc:SetString(nPOrder++, "%"+cSearch+"%")
EndIf
oStatementProc:SetString(nPOrder++, cValToChar(nStart))
oStatementProc:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStatementProc:OpenAlias()

While !(cAlias)->(Eof())  
	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf 
	
	oItem := JSonObject():new()
	oItem["filProc"]  := EncodeUTF8((cAlias)->RCJ_FILIAL)
	oItem["procCode"] := EncodeUTF8((cAlias)->RCJ_CODIGO)
	oItem["procName"] := EncodeUTF8(RTrim((cAlias)->RCJ_DESCRI))

	aadd(oResponse["items"], oItem)
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext 

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} Get getRoteiroRhGestao
Serviço para retornar uma lista de roteiros de cálculo

@author	Bruno Costa
@since	19/05/2026
-------------------------------------------------------------------*/
method getRoteiroRhGestao() class GPEGestao
local oItem	as object
local jParams := oRest:getQueryRequest() as json
local oResponse := JsonObject():New() as json
local cSearch as character
local cAlias as character		
local cQuery as character 
local cProc as character
local cJoinRCH as character
local cRotRel as character
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nTam as numeric
local nI as numeric
local lHasNext as logical
local lTemFil as logical
local aFilPar as array

Static oStatementRot

cSearch   := Upper(IIf(jParams:hasProperty("filter"), jParams["filter"], ""))
cProc	  := IIf(jParams:hasProperty("procCode"), jParams["procCode"], "")
cRotRel	  := IIf(jParams:hasProperty("rotCode"), jParams["rotCode"], "")
cJoinRCH  := FwJoinFilial("RCH", "SRY")
aFilPar   := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams["branchCode"], ","), {})
nPage     := Val(jParams["page"])
nPageSize := Val(jParams["pageSize"])
nPOrder   := 1

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

nStart := If(!Empty(cSearch), 1, (nPage - 1) * nPageSize + 1)
nEnd   := nPage * nPageSize + 1

oResponse["items"] := {}

If (nTam := Len(Rtrim(xFilial("RCH")))) > 0 
	For nI := 1 To Len(aFilPar)
      aFilPar[nI] := SubStr(aFilPar[nI], 1, nTam)
	  lTemFil := .T.
	Next nI
EndIf

If oStatementRot == Nil .Or. nStart == 1 .Or. !Empty(cSearch) .Or. !Empty(cRotRel)
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RCH.RCH_FILIAL, RCH.RCH_PROCES ASC) AS LINHA, "
	cQuery += " RCH.RCH_FILIAL, RCH.RCH_PROCES, RCH.RCH_PER, RCH.RCH_NUMPAG, RCH.RCH_ROTEIR "
	cQuery += " FROM "+RetSqlName("RCH")+" RCH "
	cQuery += " INNER JOIN " + RetSqlName("SRY") + " SRY ON " + cJoinRCH + " AND SRY.RY_CALCULO = RCH.RCH_ROTEIR AND SRY.RY_INTEGRA = ? AND SRY.D_E_L_E_T_ = ? "
	cQuery += " WHERE RCH.RCH_PROCES = ? AND RCH.D_E_L_E_T_ = ? " + If(lTemFil, "AND RCH.RCH_FILIAL IN (?)", "")
	If !Empty(cSearch) 
		cQuery += " AND (UPPER(RCH.RCH_PROCES) LIKE ? OR UPPER(RCH.RCH_PER) LIKE ? OR UPPER(RCH.RCH_ROTEIR) LIKE ?) "
	EndIf
	If !Empty(cRotRel)
		cQuery += " AND RCH.RCH_ROTEIR = ? "
	EndIf
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	cQuery        := ChangeQuery(cQuery) 
	oStatementRot := FwExecStatement():New(cQuery)
EndIf

oStatementRot:SetString(nPOrder++, "2")
oStatementRot:SetString(nPOrder++, " ")
oStatementRot:SetString(nPOrder++, cProc)
oStatementRot:SetString(nPOrder++, " ")
If lTemFil
	oStatementRot:SetIn(nPOrder++, aFilPar)
EndIf
If !Empty(cSearch)
	oStatementRot:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementRot:SetString(nPOrder++, "%"+cSearch+"%")
	oStatementRot:SetString(nPOrder++, "%"+cSearch+"%")
EndIf
If !Empty(cRotRel)
	oStatementRot:SetString(nPOrder++, cRotRel)
EndIf
oStatementRot:SetString(nPOrder++, cValToChar(nStart))
oStatementRot:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStatementRot:OpenAlias()

While !(cAlias)->(Eof())  
	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf 
	
	oItem := JSonObject():new()
	oItem["filRot"]   := EncodeUTF8((cAlias)->RCH_FILIAL)
	oItem["rotProc"]  := EncodeUTF8((cAlias)->RCH_PROCES)
	oItem["rotPer"]   := EncodeUTF8((cAlias)->RCH_PER)
	oItem["rotNumPg"] := EncodeUTF8((cAlias)->RCH_NUMPAG)
	oItem["rotCode"]  := EncodeUTF8((cAlias)->RCH_ROTEIR)

	aadd(oResponse["items"], oItem)
	
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext 

oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} Get getMensagensGestao
API de busca das mensagens da RCC

@author	Bruno Costa
@since	25/05/2026
-------------------------------------------------------------------*/
Method getMensagensGestao() class GPEGestao
local oItem	as object
local jParams := oRest:getQueryRequest() as json
local oResponse := JsonObject():New() as json
local cSearch as character
local cAlias as character		
local cQuery as character 
local cTableCode as character
local cRCBBranch as character
local cFilPar as character
local cFilAlt as character
local cCode as character
local nPageSize as numeric
local nPOrder as numeric
local nStart as numeric
local nPage as numeric
local nEnd as numeric
local nTam as numeric
local nFieldSize as numeric
local nCodeSize as numeric
local nDescSize as numeric
local lHasNext as logical

Static oStaMsn  

cTableCode := "S036"
nFieldSize := GetSX3Cache("RCB_CAMPOS", "X3_TAMANHO")
cRCBBranch := FwXFilial("RCB")
nCodeSize  := Posicione("RCB", 3, cRCBBranch + PadR("Codigo",   nFieldSize) + cTableCode, "RCB_TAMAN")
nDescSize  := Posicione("RCB", 3, cRCBBranch + PadR("Mensagem", nFieldSize) + cTableCode, "RCB_TAMAN")
cSearch    := Upper(IIf(jParams:hasProperty("filter"), jParams["filter"], ""))
cFilPar    := IIf(jParams:hasProperty("branchCode"), jParams["branchCode"], "")
nPage      := Val(jParams["page"])
nPageSize  := Val(jParams["pageSize"])
nPOrder    := 1
nStart     := If(!Empty(cSearch), 1, (nPage - 1) * nPageSize + 1)
nEnd       := nPage * nPageSize + 1

If (nTam := Len(Rtrim(xFilial("RCC")))) > 0 
    cFilAlt := SubStr(cFilPar, 1, nTam)
EndIf

oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

oResponse["items"] := {}

If oStaMsn == Nil .Or. nStart == 1 .Or. !Empty(cSearch)   
	cQuery := "SELECT * FROM ( "
	cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RCC_FILIAL, RCC_FIL, RCC_SEQUEN ASC) AS LINHA, "
	cQuery += "RCC_CONTEU, RCC_FIL, RCC_FILIAL, RCC_SEQUEN "
	cQuery += "FROM " + RetSQLName("RCC") + " WHERE RCC_CODIGO = ? " + If(!Empty(cFilAlt), " AND RCC_FILIAL = ? ", "")
	cQuery += " AND (RCC_FIL = ? OR RCC_FIL = ?) "
	If !Empty(cSearch) 
		cQuery += " AND (UPPER(SUBSTRING(RCC_CONTEU, 1, ?)) LIKE UPPER(?) OR " 
		cQuery += "UPPER(SUBSTRING(RCC_CONTEU, ?, ?)) LIKE UPPER(?)) "         
	EndIf
	cQuery +=  " AND D_E_L_E_T_ = ? " 
	cQuery += ") TAB "
	cQuery += "WHERE LINHA BETWEEN ? AND ?"

	cQuery  := ChangeQuery(cQuery)
	oStaMsn := FWExecStatement():New(cQuery)
EndIf 

oStaMsn:SetString(nPOrder++, cTableCode) 
If !Empty(cFilAlt)
	oStaMsn:SetString(nPOrder++, cFilAlt) 
EndIf
oStaMsn:SetString(nPOrder++, cFilPar) 
oStaMsn:SetString(nPOrder++, " ") 
If !Empty(cSearch) 
	oStaMsn:SetUnsafe(nPOrder++, cValToChar(nCodeSize))       
	oStaMsn:SetString(nPOrder++, "%" + cSearch + "%") 
	oStaMsn:SetUnsafe(nPOrder++, cValToChar(nCodeSize + 1))    
	oStaMsn:SetUnsafe(nPOrder++, cValToChar(nDescSize))        
	oStaMsn:SetString(nPOrder++, "%" + cSearch + "%") 
EndIf

oStaMsn:SetString(nPOrder++, " ") 
oStaMsn:SetString(nPOrder++, cValToChar(nStart))
oStaMsn:SetString(nPOrder++, cValToChar(nEnd))

cAlias := oStaMsn:OpenAlias()

While !(cAlias)->(Eof())  
	If (cAlias)->LINHA > (nEnd - 1)
		lHasNext := .T.
		Exit 
	EndIf 
	
	If !Empty(cCode := AllTrim(SubStr((cAlias)->RCC_CONTEU, 1, nCodeSize)))
		oItem := JSonObject():new()
		oItem["filMSN"]   := FwHttpEncode(AllTrim(IIf(!Empty((cAlias)->RCC_FIL), (cAlias)->RCC_FIL, (cAlias)->RCC_FILIAL)))
		oItem["codeMSN"]  := FwHttpEncode(cCode)
		oItem["sequence"] := FwHttpEncode(AllTrim((cAlias)->RCC_SEQUEN))
		oItem["descMSN"]  := FwHttpEncode(AllTrim(SubStr((cAlias)->RCC_CONTEU, nCodeSize + 1, nDescSize)))

		aadd(oResponse["items"], oItem)
	EndIf 
	(cAlias)->(DbSkip())
EndDo

(cAlias)->(dbCloseArea())
oResponse["hasNext"] := lHasNext 

oRest:setResponse(oResponse:toJson())

return 

/*-------------------------------------------------------------------
{Protheus.doc} Get postRelatorioRhGestao
API de envio da requisição para geração do relatório

@author	Bruno Costa
@since	25/05/2026
-------------------------------------------------------------------*/
method postRelatorioRhGestao() class GPEGestao
local oSmartView as object
local oFile as object
local oJsBadResp as object
local oJsBody := JsonObject():new() as json
local jPrint as json
local cFile as character
local cFilePath as character
local nX as numeric

oJsBody:fromJson(oRest:GetBodyRequest())

If Len(oJsBody['situacao']) > 0
	For nX := 1 To Len(oJsBody['situacao'])
		If oJsBody['situacao'][nX] == "N"
			oJsBody['situacao'][nX] := " "
		EndIf 	
	Next nX
EndIf 

oSmartView := totvs.framework.smartview.callSmartView():new("rh.sv.gpe.gper084.default.rep", "report")
oSmartView:setNoInterface(.T.)
oSmartView:setPrintType(1)
oSmartView:setParam("PAR_IMPLOTE", oJsBody['impLote']) 
oSmartView:setParam("PAR_PROCESSO", oJsBody['processoRelatorio'])
oSmartView:setParam("PAR_ROTEIRO", oJsBody['rotRelatorio'])
oSmartView:setParam("PAR_PERDE", oJsBody['periodoDe'])
oSmartView:setParam("PAR_SEMDE", oJsBody['semanaDe'])
oSmartView:setParam("PAR_PERATE", oJsBody['periodoAte'])
oSmartView:setParam("PAR_SEMATE", oJsBody['semanaAte'])
oSmartView:setParam("PAR_FIL", oJsBody['branchCode'])
oSmartView:setParam("PAR_CCDE", oJsBody['codCC'])
oSmartView:setParam("PAR_CCATE", oJsBody['codCCAte'])
oSmartView:setParam("PAR_MATDE", oJsBody['matCode'])
oSmartView:setParam("PAR_MATATE", oJsBody['matCodeAte'])
oSmartView:setParam("PAR_NOMEDE", oJsBody['nomeDe'])
oSmartView:setParam("PAR_NOMEATE", oJsBody['nomeAte'])
oSmartView:setParam("PAR_CHAPADE", oJsBody['chapaDe'])
oSmartView:setParam("PAR_CHAPAATE", oJsBody['chapaAte'])
oSmartView:setParam("PAR_MSG", oJsBody['impMSN'])
oSmartView:setParam("PAR_DEPDE", oJsBody['codDepto'])
oSmartView:setParam("PAR_DEPATE", oJsBody['codDeptoAte'])
oSmartView:setParam("PAR_SEXAGESI", oJsBody['sexagesimal'])
oSmartView:setParam("PAR_SIT", oJsBody['situacao'])
oSmartView:setParam("PAR_CAT", oJsBody['categoria'])
oSmartView:setForceParams(.T.)

jPrint := jsonObject():new()
jPrint['name']      := "Folha_Analitica_Gestao"+FwTimeStamp()
jPrint['extension'] := "pdf"
jPrint['path']      := "\spool\"

oSmartView:setPrintInfo(jPrint)  

If !oSmartView:executeSmartView()
	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oJsBadResp := JSonObject():new()
    oJsBadResp['code']    := CodeRespBadRequest
    oJsBadResp['message'] := FwHttpEncode(STR0013) //"Não foi possível abrir o Smart View. Verifique se o servidor REST está no ar ou contate o administrador do sistema."
    oRest:setStatusCode(CodeRespBadRequest)
	oRest:setResponse(oJsBadResp:toJson())
Else   		
	cFilePath := jPrint['path']+jPrint['name']+"."+jPrint['extension']
	oFile := FwFileReader():New(cFilePath)

	If oFile:open()
		cFile := oFile:fullRead()
		oRest:updateKeyHeaderResponse("Content-Type", "application/pdf")
		oRest:updateKeyHeaderResponse("Content-Disposition", "inline; filename=" + jPrint['name'] + ".pdf")
		oRest:setResponse(cFile)
	EndIf

	oFile:close()
	FreeObj(oFile)
EndIf 

oSmartView:destroy()

return
